<Window x:Class="Nitrous.Ui.ScenariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nitrous.Ui.Controls"
        Title="Scenario Manager" Height="660" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Nitrous;component/Ui/Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid x:Name="WindowRoot" Background="Transparent">
		<Path x:Name="WindowShellFrame"
		      Stroke="{StaticResource Steel600Brush}" StrokeThickness="1"
		      Fill="{StaticResource Steel900Brush}" SnapsToDevicePixels="True" />
		<Grid x:Name="WindowContentGrid" Margin="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="40" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- Title bar -->
			<Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="{StaticResource Steel950Brush}">
				<Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Steel700Brush}" />
				<TextBlock Text="SCENARIO MANAGER" Foreground="{StaticResource Steel100Brush}"
				           FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold"
				           VerticalAlignment="Center" Margin="14,0,0,0" />
				<Button Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,12,0"
				        Click="CloseBtn_Click" Cursor="Hand"
				        ToolTip="Close — scenarios keep running from the tray.">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{StaticResource Steel850Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1">
								<Path Data="M6,18L18,6M6,6L18,18" Stroke="{StaticResource Steel400Brush}" StrokeThickness="1.5"
								      Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</Grid>

			<!-- Body -->
			<Grid Grid.Row="1" Margin="12,10,12,12">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- Enable card (dashboard card style) -->
				<controls:ChamferCard Grid.Row="0" ChamferSize="6" Background="{StaticResource Steel950Brush}"
				                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
				                      Margin="0,0,0,10" Padding="12,8,12,10">
					<Grid VerticalAlignment="Center">
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="SCENARIOS" Foreground="{StaticResource Steel300Brush}"
							           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
							<TextBlock x:Name="ScenarioStatusText" Text="Disabled. Turn on to let Tray apply scenarios and App Sync."
							           Foreground="{StaticResource Steel400Brush}"
							           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,3,0,0" />
						</StackPanel>
						<CheckBox x:Name="ScenarioEnabledCheck" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
						          IsChecked="{Binding ScenarioEnabled, Mode=TwoWay}"
						          Checked="ScenarioEnabledCheck_Changed" Unchecked="ScenarioEnabledCheck_Changed"
						          ToolTip="Master switch. Turn this on first: when off, Tray ignores every scenario apply." />
					</Grid>
				</controls:ChamferCard>

				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="220" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Profile list card -->
					<controls:ChamferCard Grid.Column="0" ChamferSize="6" Background="{StaticResource Steel950Brush}"
					                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
					                      Margin="0,0,10,0" Padding="12,10,12,12">
						<StackPanel>
							<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
								<TextBlock Text="PROFILE LIST" Foreground="{StaticResource Steel300Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
							</Border>
							<ListBox x:Name="ScenarioList" Height="218"
							         ItemsSource="{Binding ScenarioProfiles}"
							         SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
							         DisplayMemberPath="Name"
							         Background="{StaticResource Steel900Brush}"
							         Foreground="{StaticResource Steel100Brush}"
							         BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
							         FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
							         ToolTip="Select a scenario to edit. Editing does not change hardware until Apply." />
							<Grid Margin="0,10,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:ChamferButton Grid.Column="0" Variant="Secondary" ChamferSize="3" Height="26" Margin="0,0,4,0"
								                        Content="NEW" Command="{Binding CreateScenarioCommand}"
								                        ToolTip="Create a scenario. Maximum 15 scenarios." />
								<controls:ChamferButton Grid.Column="1" Variant="Secondary" ChamferSize="3" Height="26" Margin="4,0,0,0"
								                        Content="DUPLICATE" Command="{Binding DuplicateScenarioCommand}"
								                        ToolTip="Duplicate selected scenario. App links are not copied." />
							</Grid>
							<Grid Margin="0,6,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:ChamferButton Grid.Column="0" Variant="Secondary" ChamferSize="3" Height="26" Margin="0,0,4,0"
								                        Content="DELETE" Command="{Binding DeleteScenarioCommand}"
								                        ToolTip="Delete selected scenario. Last scenario cannot be deleted." />
								<controls:ChamferButton Grid.Column="1" Variant="Secondary" ChamferSize="3" Height="26" Margin="4,0,0,0"
								                        Content="RESTORE" Command="{Binding RestoreScenarioCommand}"
								                        ToolTip="Restore selected scenario to factory preset values. App links are cleared." />
							</Grid>
							<controls:ChamferButton Variant="Primary" ChamferSize="3" Height="28" Margin="0,8,0,0"
							                        Content="SAVE" Command="{Binding SaveScenarioCommand}"
							                        ToolTip="Save edits. Hardware does not change until Apply." />
							<controls:ChamferButton Variant="Primary" ChamferSize="3" Height="30" Margin="0,14,0,0"
							                        Content="APPLY" Command="{Binding ApplyScenarioCommand}"
							                        ToolTip="Save, enable scenarios, and signal Tray to apply this scenario." />						
						</StackPanel>
					</controls:ChamferCard>

					<!-- Editor column 1: Profile + Fan -->
					<StackPanel Grid.Column="1" Margin="0,0,10,0">
						<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
						                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
						                      Margin="0,0,0,10" Padding="12,10,12,12">
							<StackPanel>
								<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
									<TextBlock Text="PROFILE" Foreground="{StaticResource Steel300Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
								</Border>
								<TextBlock Text="NAME" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
								<TextBox Style="{StaticResource HotkeyTextBoxStyle}" Height="26" Margin="0,0,0,10"
								         Text="{Binding ScenarioName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Text="MODE (AC PLUGGED IN)" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
								<ComboBox Style="{StaticResource CompactComboBoxStyle}" Height="26" Margin="0,0,0,10"
								          ItemsSource="{Binding ScenarioPowerModes}" SelectedItem="{Binding ScenarioAcMode, Mode=TwoWay}"
								          ToolTip="Power mode used while AC adapter is connected." />
								<TextBlock Text="MODE (ON BATTERY)" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
								<ComboBox Style="{StaticResource CompactComboBoxStyle}" Height="26"
								          ItemsSource="{Binding ScenarioPowerModes}" SelectedItem="{Binding ScenarioDcMode, Mode=TwoWay}"
								          ToolTip="Power mode used on battery. Turbo falls back to Performance when unsupported." />
							</StackPanel>
						</controls:ChamferCard>

						<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
						                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
						                      Padding="12,10,12,12">
							<StackPanel>
								<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
									<TextBlock Text="FAN" Foreground="{StaticResource Steel300Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
								</Border>
								<TextBlock Text="FAN CONTROL" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
								<ComboBox Style="{StaticResource CompactComboBoxStyle}" Height="26"
								          ItemsSource="{Binding ScenarioFanControlKinds}" SelectedItem="{Binding ScenarioFanControlKind, Mode=TwoWay}"
								          ToolTip="Auto, Quiet, and Max are built-in fan behaviors. Fixed Speed locks fan speeds. Curve follows temperature." />
								<StackPanel Visibility="{Binding IsScenarioFixedFan, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
									<TextBlock Text="CPU FAN SPEED %" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
									<Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
									        Value="{Binding ScenarioFanSpeedCpu, Mode=TwoWay}"
									        ToolTip="Fans lock at this CPU fan speed, clamped to 0-100%." />
									<TextBlock Text="{Binding ScenarioFanSpeedCpu}" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Margin="0,0,0,8" />
									<TextBlock Text="GPU FAN SPEED %" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
									<Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
									        Value="{Binding ScenarioFanSpeedGpu, Mode=TwoWay}"
									        ToolTip="Fans lock at this GPU fan speed, clamped to 0-100%." />
									<TextBlock Text="{Binding ScenarioFanSpeedGpu}" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" />
									<TextBlock Text="Fans stay locked at these speeds." Foreground="{StaticResource Steel400Brush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,4,0,0" />
								</StackPanel>
								<StackPanel Visibility="{Binding IsScenarioCurveFan, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
									<TextBlock Text="FAN CURVE PRESET" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
									<ComboBox Style="{StaticResource CompactComboBoxStyle}" Height="26"
									          ItemsSource="{Binding ScenarioCurvePresets}" SelectedItem="{Binding ScenarioCurvePreset, Mode=TwoWay}"
									          ToolTip="Which saved temperature curve the fans follow in this scenario." />
									<TextBlock Text="Fan speed follows temperature using this curve." Foreground="{StaticResource Steel400Brush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,4,0,0" />
								</StackPanel>
							</StackPanel>
						</controls:ChamferCard>
					</StackPanel>

					<!-- Editor column 2: Keyboard + App Sync -->
					<StackPanel Grid.Column="2">
						<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
						                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
						                      Margin="0,0,0,10" Padding="12,10,12,12">
							<StackPanel>
								<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
									<TextBlock Text="KEYBOARD" Foreground="{StaticResource Steel300Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
								</Border>
								<Grid Margin="0,0,0,10">
									<TextBlock Text="30S BACKLIGHT TIMEOUT" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
									<CheckBox Style="{StaticResource SquareCheckBoxStyle}" HorizontalAlignment="Right"
									          IsChecked="{Binding ScenarioBacklightTimeout, Mode=TwoWay}"
									          ToolTip="Keyboard backlight turns off after 30 seconds of inactivity in this scenario." />
								</Grid>
								<StackPanel x:Name="LightingEffectPanel">
									<TextBlock Text="LIGHTING EFFECT" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
									<ComboBox Style="{StaticResource CompactComboBoxStyle}" Height="26" Margin="0,0,0,10"
									          ItemsSource="{Binding ScenarioEffects}" SelectedItem="{Binding ScenarioLightingEffect, Mode=TwoWay}" />
								</StackPanel>
								<StackPanel x:Name="ZoneColorsPanel">
									<TextBlock Text="ZONE COLORS (HEX)" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<TextBox Grid.Row="0" Grid.Column="0" Style="{StaticResource HotkeyTextBoxStyle}" Height="26" Margin="0,0,4,4" Text="{Binding ScenarioZoneColor1, Mode=TwoWay}" ToolTip="Zone 1 color, hex like #FF0000." />
										<TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource HotkeyTextBoxStyle}" Height="26" Margin="4,0,0,4" Text="{Binding ScenarioZoneColor2, Mode=TwoWay}" ToolTip="Zone 2 color, hex like #FF0000." />
										<TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource HotkeyTextBoxStyle}" Height="26" Margin="0,0,4,0" Text="{Binding ScenarioZoneColor3, Mode=TwoWay}" ToolTip="Zone 3 color, hex like #FF0000." />
										<TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyTextBoxStyle}" Height="26" Margin="4,0,0,0" Text="{Binding ScenarioZoneColor4, Mode=TwoWay}" ToolTip="Zone 4 color, hex like #FF0000." />
									</Grid>
								</StackPanel>
							</StackPanel>
						</controls:ChamferCard>

						<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
						                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
						                      Padding="12,10,12,12">
							<StackPanel>
								<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
									<TextBlock Text="APP SYNC" Foreground="{StaticResource Steel300Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" />
								</Border>
								<Grid Margin="0,0,0,8">
									<TextBlock Text="AUTO-SWITCH FOR THIS SCENARIO" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
									<CheckBox Style="{StaticResource SquareCheckBoxStyle}" HorizontalAlignment="Right"
									          IsChecked="{Binding ScenarioAppSyncEnabled, Mode=TwoWay}"
									          ToolTip="When a linked app runs, Tray applies this scenario. Several running apps merge: strongest setting wins per group." />
								</Grid>
								<ListBox x:Name="ScenarioAppList" Height="96" Margin="0,0,0,6"
								         ItemsSource="{Binding ScenarioLinkedApps}"
								         Background="{StaticResource Steel900Brush}" Foreground="{StaticResource Steel100Brush}"
								         BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
								         FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
								         ToolTip="Linked apps for this scenario. An app can link to only one scenario. Maximum 12 apps.">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Path}">
												<Image Source="{Binding Icon}" Width="20" Height="20" Margin="2,2,8,2" Stretch="Uniform" />
												<TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
												           Foreground="{StaticResource Steel100Brush}"
												           FontFamily="{StaticResource MonoFontFamily}" FontSize="11" />
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<controls:ChamferButton Grid.Column="0" Variant="Secondary" ChamferSize="3" Height="26" Margin="0,0,4,0"
									                        Content="ADD APP" Click="AddApp_Click" />
									<controls:ChamferButton Grid.Column="1" Variant="Secondary" ChamferSize="3" Height="26" Margin="4,0,0,0"
									                        Content="REMOVE" Click="RemoveApp_Click" />
								</Grid>
							</StackPanel>
						</controls:ChamferCard>
					</StackPanel>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Window>
