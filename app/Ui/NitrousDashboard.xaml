<Window x:Class="Nitrous.Ui.NitrousDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nitrous Dashboard" Height="660" Width="375"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        IsVisibleChanged="Window_IsVisibleChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Deactivated="Window_Deactivated">
	<Window.Resources>
		<BitmapImage x:Key="CachedAppLogo" UriSource="pack://application:,,,/Nitrous;component/assets/logo.png"
		             CacheOption="OnLoad" />
		<Style x:Key="ActionButtonStyle" TargetType="RadioButton">
			<!-- Default state: Transparent background to blend into the rail -->
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="TabIndex" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid Background="Transparent">
							<Border x:Name="LeftDivider"
							        Width="1"
							        Height="16"
							        Background="#222226"
							        HorizontalAlignment="Left"
							        VerticalAlignment="Center" />
							<!-- Main Floating Pill -->
							<Border x:Name="MainBorder"
							        Background="{TemplateBinding Background}"
							        BorderBrush="{TemplateBinding BorderBrush}"
							        BorderThickness="{TemplateBinding BorderThickness}"
							        CornerRadius="6"
							        Margin="0"
							        SnapsToDevicePixels="True">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
									      Fill="{TemplateBinding Foreground}"
									      Stretch="Uniform"
									      Width="14" Height="14"
									      Margin="0,0,6,0"
									      VerticalAlignment="Center" />
									<TextBlock Text="{TemplateBinding Content}"
									           Foreground="{TemplateBinding Foreground}"
									           FontSize="11"
									           FontWeight="SemiBold"
									           VerticalAlignment="Center" />
								</StackPanel>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<!-- Hide the divider if this is the very first item in the track -->
							<Trigger Property="TabIndex" Value="0">
								<Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed" />
							</Trigger>
							<!-- Hover State -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MainBorder" Property="Background" Value="#1E1E22" />
								<Setter Property="Foreground" Value="#E0E0E0" />
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0" />
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0" />
								<Setter Property="Panel.ZIndex" Value="1" />
							</Trigger>
							<!-- Checked State -->
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF4500" />
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0" />
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0" />
								<!-- Elevating Z-Index ensures the active pill draws OVER the dividers of its neighbors -->
								<Setter Property="Panel.ZIndex" Value="2" />
							</Trigger>
							<!-- Disabled State -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3" />
								<Setter Property="Cursor" Value="Arrow" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern iOS-style Toggle -->
		<Style x:Key="ModernToggleStyle" TargetType="CheckBox">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Border x:Name="BgBorder" Width="44" Height="24" CornerRadius="12" Background="#35353A">
							<Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#FF4500" />
								<Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
								<Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
								<Setter TargetName="Thumb" Property="Fill" Value="#0C0C0E" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern Slider -->
		<Style x:Key="ModernSliderStyle" TargetType="Slider">
			<Setter Property="SmallChange" Value="1" />
			<Setter Property="LargeChange" Value="10" />
			<Setter Property="IsMoveToPointEnabled" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Slider">
						<Grid Height="20">
							<Border Height="4" Background="#222226" CornerRadius="2" VerticalAlignment="Center" />
							<Track x:Name="PART_Track">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="Slider.DecreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Height="4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
												        CornerRadius="2" />
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb>
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Ellipse Width="14" Height="14" Fill="White"
												         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
												         StrokeThickness="1" Cursor="Hand" />
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="Slider.IncreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Background="Transparent" />
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Custom Fan Toggle -->
		<Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border Width="12" Height="12" Background="White" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
								<Path x:Name="CheckIcon" Data="M3,8L6,11L11,3" Stroke="#0C0C0E" StrokeThickness="2" Stretch="Uniform"
								      Margin="2" Visibility="Collapsed" />
							</Border>
							<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="10"
							           FontWeight="Bold" VerticalAlignment="Center" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Bottom Nav Button -->
		<Style x:Key="NavButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
						        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#17171A" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />

		<Style x:Key="GhostBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="#A1A1AA" />
			<Setter Property="BorderBrush" Value="#222226" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="BtnBorder" Property="Background" Value="#1E1E22" />
								<Setter Property="Foreground" Value="#E0E0E0" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="AccentBtn" TargetType="Button">
			<Setter Property="Foreground" Value="#0C0C0E" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="8">
							<Grid>
								<Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="8" />
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="HotkeyTextBoxStyle" TargetType="TextBox">
			<Setter Property="Background" Value="#26262A" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6" Padding="0,4,0,0">
							<ScrollViewer x:Name="PART_ContentHost" Margin="0" />
						</Border>
						<ControlTemplate.Triggers>
							<!-- Hover effect -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#2D2D32" />
							</Trigger>
							<!-- Clicked / Active effect -->
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter Property="BorderBrush" Value="#FF4500" />
								<Setter Property="Background" Value="#151518" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Modern Dark Tooltip Style -->
		<Style TargetType="ToolTip">
			<Setter Property="Background" Value="#1E1E22" />
			<Setter Property="Foreground" Value="#D8D8E0" />
			<Setter Property="BorderBrush" Value="#323238" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="9,6" />
			<Setter Property="HasDropShadow" Value="True" />
			<Setter Property="ToolTipService.InitialShowDelay" Value="400" />
			<Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
			<Setter Property="ToolTipService.ShowDuration" Value="7000" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToolTip">
						<Border Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        Padding="{TemplateBinding Padding}"
						        SnapsToDevicePixels="True"
						        MaxWidth="280">
							<TextBlock Text="{TemplateBinding Content}"
							           Foreground="{TemplateBinding Foreground}"
							           FontSize="{TemplateBinding FontSize}"
							           TextWrapping="Wrap" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<!-- Outer Frame with Rounded Corners -->
	<Border Background="#0C0C0E" CornerRadius="16" BorderBrush="#222226" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="50" />
				<RowDefinition Height="*" />
				<RowDefinition Height="54" />
			</Grid.RowDefinitions>
			<!-- Title Bar -->
			<Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
					<TextBlock x:Name="SystemModelText" Text="NITROUS ON SYSTEM" Foreground="White" FontSize="13" FontWeight="Bold"
					           Margin="0,0,8,0" />
					<TextBlock Text="•" Foreground="#55555C" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
					<Path x:Name="DashPowerPillIcon" Fill="{Binding BatteryBadgeForeground}" Stretch="Uniform" Width="10" Height="10"
					      VerticalAlignment="Center" Margin="0,0,4,0" Data="{Binding BatteryBadgeIcon}" />
					<TextBlock x:Name="DashPowerPillText" Text="{Binding BatteryBadgeText}"
					           Foreground="{Binding BatteryBadgeForeground}" FontSize="10" FontWeight="Bold"
					           VerticalAlignment="Center" />
				</StackPanel>
				<!-- Right Side: Pin to Top & Close -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
					<!-- 2. Pin to Top Toggle -->
					<ToggleButton x:Name="BtnPinTop"
					              Cursor="Hand"
					              Margin="0,0,12,0"
					              ToolTip="Keeps the Nitrous window floating above all other applications."
					              IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
						<ToggleButton.Template>
							<ControlTemplate TargetType="ToggleButton">
								<Grid Background="Transparent">
									<Path x:Name="PinIcon"
									      Fill="#A1A1AA"
									      Stretch="Uniform"
									      Width="13"
									      Height="13"
									      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
									      VerticalAlignment="Center" />
								</Grid>
								<ControlTemplate.Triggers>
									<!-- Hover state: Brightens up like the close button -->
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="#E0E0E0" />
									</Trigger>
									<!-- Checked state: Lights up with your purple accent color -->
									<Trigger Property="IsChecked" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="#FF4500" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</ToggleButton.Template>
					</ToggleButton>
					<!-- 3. Close Button -->
					<Button Content="✕" Foreground="#A1A1AA" Background="Transparent" BorderThickness="0" FontSize="14"
					        FontWeight="Bold" Click="CloseBtn_Click" Cursor="Hand"
					        ToolTip="Close dashboard window. Nitrous continues running silently in the system tray.">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
				<Border VerticalAlignment="Bottom" Height="1" Background="#222226" />
			</Grid>
			<!-- PAGES -->
			<Grid Grid.Row="1">
				<!-- 1. DASHBOARD PAGE -->
				<StackPanel x:Name="DashPage" Visibility="Visible" Margin="20,10,20,0">
					<!-- DASHBOARD GRAPH & TELEMETRY -->
					<Grid Margin="0,0,0,16" Height="140">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="10" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- CPU Graph & Telemetry -->
						<Border Grid.Column="0" Background="#151518" CornerRadius="12" BorderBrush="#222226" BorderThickness="1"
						        ClipToBounds="False"
						        ToolTip="Real-time CPU temperature, usage, and fan speed read directly from the Acer Embedded Controller (EC) and Windows.">
							<Grid Margin="10,8,10,8">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,6">
									<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
										<TextBlock Foreground="#A1A1AA" FontSize="10" FontWeight="Bold">
											<Run Text="CPU" />
											<Run Text=" • " Foreground="#55555C" />
											<Run Text="{Binding CpuUsageText}" />
										</TextBlock>
										<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
											<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0"
											      Data="M9,2V4H15V2H17V4H19A2,2 0 0,1 21,6V8H23V10H21V16H23V18H21V20A2,2 0 0,1 19,22H17V24H15V22H9V24H7V22H5A2,2 0 0,1 3,20V18H1V16H3V10H1V8H3V6A2,2 0 0,1 5,4H7V2H9M5,6V20H19V6H5M7,8H17V18H7V8M9,10H15V16H9V10Z" />
											<TextBlock Text="{Binding CpuRpmText}" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold" />
										</StackPanel>
									</StackPanel>
									<TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempColor}" FontSize="18" FontWeight="Bold"
									           HorizontalAlignment="Right" VerticalAlignment="Center" />
								</Grid>
								<Grid Grid.Row="1" x:Name="CpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
								      MouseLeave="Graph_MouseLeave">
									<Polygon Points="{Binding CpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
									<Polygon Points="{Binding CpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
									<Polyline Points="{Binding CpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
									<Polyline Points="{Binding CpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
									<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding CpuHoverMargin}"
									        Visibility="{Binding CpuHoverVisibility}" />
									<Border Background="#151518" BorderBrush="#222226" BorderThickness="1" CornerRadius="4" Padding="6"
									        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding CpuTooltipMargin}"
									        Visibility="{Binding CpuHoverVisibility}">
										<StackPanel>
											<TextBlock Text="{Binding CpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
											<StackPanel Orientation="Horizontal" Margin="0,2">
												<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
												<TextBlock Text="{Binding CpuHoverTempStr}" FontSize="11" Foreground="White" />
											</StackPanel>
											<StackPanel Orientation="Horizontal" Margin="0,2">
												<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
												<TextBlock Text="{Binding CpuHoverUsageStr}" FontSize="11" Foreground="White" />
											</StackPanel>
										</StackPanel>
									</Border>
								</Grid>
								<TextBlock Grid.Row="2" Text="{Binding CpuMaxStatsText}" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"
								           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0" />
							</Grid>
						</Border>

						<!-- GPU Graph & Telemetry -->
						<Border Grid.Column="2" Background="#151518" CornerRadius="12" BorderBrush="#222226" BorderThickness="1"
						        ClipToBounds="False" ToolTip="Discrete GPU thermals and usage.">
							<Grid Margin="10,8,10,8">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,6">
									<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
										<TextBlock Foreground="#A1A1AA" FontSize="10" FontWeight="Bold">
											<Run Text="GPU" />
											<Run Text=" • " Foreground="#55555C" />
											<Run Text="{Binding GpuUsageText}" />
										</TextBlock>
										<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
											<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0"
											      Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19M6,13H11V17H6V13M12,7H16V10H12V7M6,7H11V12H6V7M12,11H16V17H12V11Z" />
											<TextBlock Text="{Binding GpuRpmText}" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold" />
										</StackPanel>
									</StackPanel>
									<TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempColor}" FontSize="18" FontWeight="Bold"
									           HorizontalAlignment="Right" VerticalAlignment="Center" />
								</Grid>
								<Grid Grid.Row="1" x:Name="GpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
								      MouseLeave="Graph_MouseLeave">
									<Polygon Points="{Binding GpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
									<Polygon Points="{Binding GpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
									<Polyline Points="{Binding GpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
									<Polyline Points="{Binding GpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
									<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding GpuHoverMargin}"
									        Visibility="{Binding GpuHoverVisibility}" />
									<Border Background="#151518" BorderBrush="#222226" BorderThickness="1" CornerRadius="4" Padding="6"
									        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding GpuTooltipMargin}"
									        Visibility="{Binding GpuHoverVisibility}">
										<StackPanel>
											<TextBlock Text="{Binding GpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
											<StackPanel Visibility="{Binding GpuHoverStatsVisibility}">
												<StackPanel Orientation="Horizontal" Margin="0,2">
													<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
													<TextBlock Text="{Binding GpuHoverTempStr}" FontSize="11" Foreground="White" />
												</StackPanel>
												<StackPanel Orientation="Horizontal" Margin="0,2">
													<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
													<TextBlock Text="{Binding GpuHoverUsageStr}" FontSize="11" Foreground="White" />
												</StackPanel>
											</StackPanel>
											<StackPanel Orientation="Horizontal" Visibility="{Binding GpuHoverSleepVisibility}">
