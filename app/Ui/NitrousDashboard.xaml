<Window x:Class="Nitrous.Ui.NitrousDashboard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nitrous Dashboard" Height="660" Width="375"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        IsVisibleChanged="Window_IsVisibleChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Deactivated="Window_Deactivated">
	<Window.Resources>
		<BitmapImage x:Key="CachedAppLogo" UriSource="pack://application:,,,/assets/logo.png" CacheOption="OnLoad" />
		<Style x:Key="ActionButtonStyle" TargetType="RadioButton">
			<!-- Default state: Transparent background to blend into the rail -->
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="TabIndex" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid Background="Transparent">
							<Border x:Name="LeftDivider"
                                    Width="1"
                                    Height="16"
                                    Background="#2A2A30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
							<!-- Main Floating Pill -->
							<Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Margin="0"
                                    SnapsToDevicePixels="True">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        Fill="{TemplateBinding Foreground}"
                                        Stretch="Uniform"
                                        Width="14" Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
									<TextBlock Text="{TemplateBinding Content}"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<!-- Hide the divider if this is the very first item in the track -->
							<Trigger Property="TabIndex" Value="0">
								<Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed"/>
							</Trigger>
							<!-- Hover State -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MainBorder" Property="Background" Value="#222226"/>
								<Setter Property="Foreground" Value="#E0E0E0"/>
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0"/>
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0"/>
								<Setter Property="Panel.ZIndex" Value="1"/>
							</Trigger>
							<!-- Checked State -->
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="MainBorder" Property="Background" Value="#1A1225"/>
								<Setter Property="Foreground" Value="#B388FF"/>
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="#B388FF"/>
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0"/>
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0"/>
								<!-- Elevating Z-Index ensures the active pill draws OVER the dividers of its neighbors -->
								<Setter Property="Panel.ZIndex" Value="2"/>
							</Trigger>
							<!-- Disabled State -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3"/>
								<Setter Property="Cursor" Value="Arrow"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern iOS-style Toggle -->
		<Style x:Key="ModernToggleStyle" TargetType="CheckBox">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Border x:Name="BgBorder" Width="44" Height="24" CornerRadius="12" Background="#35353A">
							<Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#B388FF"/>
								<Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
								<Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
								<Setter TargetName="Thumb" Property="Fill" Value="#121214"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern Slider -->
		<Style x:Key="ModernSliderStyle" TargetType="Slider">
			<Setter Property="Foreground" Value="#B388FF"/>
			<Setter Property="SmallChange" Value="1"/>
			<Setter Property="LargeChange" Value="10"/>
			<Setter Property="IsMoveToPointEnabled" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Slider">
						<Grid Height="20">
							<Border Height="4" Background="#2A2A30" CornerRadius="2" VerticalAlignment="Center"/>
							<Track x:Name="PART_Track">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="Slider.DecreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Height="4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="2"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb>
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Ellipse Width="14" Height="14" Fill="White" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" StrokeThickness="1" Cursor="Hand"/>
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="Slider.IncreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Background="Transparent"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>

						<ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Custom Fan Toggle -->
		<Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
			<Setter Property="Foreground" Value="#B388FF"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border Width="12" Height="12" Background="White" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
								<Path x:Name="CheckIcon" Data="M3,8L6,11L11,3" Stroke="#121214" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
							</Border>
							<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Bottom Nav Button -->
		<Style x:Key="NavButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#17171A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />

		<Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888890"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#222226"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
	</Window.Resources>
	<!-- Outer Frame with Rounded Corners -->
	<Border Background="#121214" CornerRadius="16" BorderBrush="#2A2A30" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="50"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="54"/>
			</Grid.RowDefinitions>
			<!-- Title Bar -->
			<Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
				<TextBlock x:Name="SystemModelText" Text="NITROUS ON SYSTEM" Foreground="White" FontSize="13" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
				<!-- Right Side: Power Pill, Pin to Top & Close -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
					<!-- 1. Dynamic Power State Pill -->
                    <Border x:Name="DashPowerPillBorder" BorderBrush="#FF453A" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                        <Grid>
                            <!-- Auto-tinting subtle background -->
                            <Border Background="{Binding BorderBrush, ElementName=DashPowerPillBorder}" Opacity="0.15" CornerRadius="5"/>

                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                <!-- Updated to an AC Power Plug icon -->
                                <Path x:Name="DashPowerPillIcon" Fill="#FF453A" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0" Data="M16,7V3H14V7H10V3H8V7C8,10 9.79,11.4 11,11.83V16H13V11.83C14.21,11.4 16,10 16,7M10,18H14V22H10V18Z"/>
                                <TextBlock x:Name="DashPowerPillText" Text="AC POWER" Foreground="#FF453A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
					<!-- 2. Pin to Top Toggle -->
					<ToggleButton x:Name="BtnPinTop"
                                Cursor="Hand"
                                Margin="0,0,12,0"
                                ToolTip="Pin to Top"
                                IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
						<ToggleButton.Template>
							<ControlTemplate TargetType="ToggleButton">
								<Grid Background="Transparent">
									<Path x:Name="PinIcon"
                                        Fill="#888890"
                                        Stretch="Uniform"
                                        Width="13"
                                        Height="13"
                                        Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                        VerticalAlignment="Center"/>
								</Grid>
								<ControlTemplate.Triggers>
									<!-- Hover state: Brightens up like the close button -->
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="#E0E0E0"/>
									</Trigger>
									<!-- Checked state: Lights up with your purple accent color -->
									<Trigger Property="IsChecked" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="#B388FF"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</ToggleButton.Template>
					</ToggleButton>
					<!-- 3. Close Button -->
					<Button Content="✕" Foreground="#888890" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="CloseBtn_Click" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
				<Border VerticalAlignment="Bottom" Height="1" Background="#2A2A30"/>
			</Grid>
			<!-- PAGES -->
			<Grid Grid.Row="1">
				<!-- 1. DASHBOARD PAGE -->
				<StackPanel x:Name="DashPage" Visibility="Visible" Margin="20,10,20,0">
					<Border Background="#1C1C1F" CornerRadius="12" Margin="0,0,0,12" Padding="12">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="44" Height="44" CornerRadius="10" Background="#26262A" Margin="0,0,12,0">
								<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock x:Name="DashVersionText" Text="Nitrous" Foreground="White" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="Pure hardware control for Acer Nitro laptops." Foreground="#888890" FontSize="11" Margin="0,2,0,0"/>
							</StackPanel>
						</StackPanel>
					</Border>
					<!-- LIVE TELEMETRY WIDGET -->
					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<!-- CPU Telemetry -->
						<Border Grid.Column="0" Background="#1C1C1F" CornerRadius="8" BorderBrush="#2A2A30" BorderThickness="1" Padding="10,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Foreground="#888890" FontSize="10" FontWeight="Bold"/>
								<!-- Inline Fan RPM -->
								<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
									<Path Fill="#B388FF" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" Data="M9,2V4H15V2H17V4H19A2,2 0 0,1 21,6V8H23V10H21V16H23V18H21V20A2,2 0 0,1 19,22H17V24H15V22H9V24H7V22H5A2,2 0 0,1 3,20V18H1V16H3V10H1V8H3V6A2,2 0 0,1 5,4H7V2H9M5,6V20H19V6H5M7,8H17V18H7V8M9,10H15V16H9V10Z"/>
									<TextBlock Text="{Binding CpuRpmText}" Foreground="#A0A0A8" FontSize="10" FontWeight="SemiBold"/>
								</StackPanel>
								<!-- Temperature on the Right -->
								<TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempColor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
							</Grid>
						</Border>
						<!-- GPU Telemetry -->
						<Border Grid.Column="2" Background="#1C1C1F" CornerRadius="8" BorderBrush="#2A2A30" BorderThickness="1" Padding="10,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.Column="0" Text="GPU" Foreground="#888890" FontSize="10" FontWeight="Bold"/>
								<!-- Inline Fan RPM -->
								<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
									<Path Fill="#B388FF" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19M6,13H11V17H6V13M12,7H16V10H12V7M6,7H11V12H6V7M12,11H16V17H12V11Z"/>
									<TextBlock Text="{Binding GpuRpmText}" Foreground="#A0A0A8" FontSize="10" FontWeight="SemiBold"/>
								</StackPanel>
								<!-- Temperature on the Right -->
								<TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempColor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
							</Grid>
						</Border>
					</Grid>
					<!-- Power Modes -->
					<TextBlock Text="POWER" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
					<Border Background="#1C1C1F" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnPowerQuiet" TabIndex="0" GroupName="Power" Uid="Quiet" Tag="M1,13 L9.4,11.5 A3,3 0 1,1 9.4,14.5 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Quiet" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Quiet"/>
							<RadioButton x:Name="BtnPowerBal" TabIndex="1" GroupName="Power" Uid="Balanced" Tag="M12,2 L13.5,10.4 A3,3 0 1,1 10.5,10.4 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Bal" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Balanced"/>
							<RadioButton x:Name="BtnPowerPerf" TabIndex="1" GroupName="Power" Uid="Performance" Tag="M19.78,5.22 L14.9,12.22 A3,3 0 1,1 12.78,10.1 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Perf" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Performance"/>
							<RadioButton x:Name="BtnPowerTurbo" TabIndex="1" GroupName="Power" Uid="Turbo" Tag="M19.78,20.78 L12.78,15.9 A3,3 0 1,1 14.9,13.78 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Turbo" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Turbo" Visibility="{Binding IsTurboSupported, Converter={StaticResource BoolToVis}}"/>
						</UniformGrid>
					</Border>
					<!-- Display Refresh Rates -->
					<TextBlock Text="DISPLAY REFRESH" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
					<Border Background="#1C1C1F" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnRefreshAuto" TabIndex="0" GroupName="Refresh" Uid="Auto" Tag="M12,4V1L7,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6.34,14H4.27A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Content="Auto" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}" CommandParameter="Auto"/>
							<RadioButton x:Name="BtnRefresh60" TabIndex="1" GroupName="Refresh" Uid="Hz60" Tag="M2,12C4.5,6.5 7.5,6.5 10.5,12C13.5,17.5 16.5,17.5 19,12H22C18.5,19.5 14.5,19.5 10.5,14C7.5,8.5 5,8.5 2,12Z" Content="60Hz" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}" CommandParameter="Hz60"/>
							<RadioButton x:Name="BtnRefreshMax" TabIndex="1" GroupName="Refresh" Uid="MaxHz" Tag="M13,2L4,14H11L9,22L20,10H13L15,2Z" Content="{Binding MaxRefreshText}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}" CommandParameter="MaxHz"/>
						</UniformGrid>
					</Border>
					<!-- Fans -->
					<TextBlock Text="FANS" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
					<Border Background="#1C1C1F" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnFanAuto" TabIndex="0" GroupName="Fans" Uid="Auto" Tag="M12,4V1L7,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6.34,14H4.27A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Content="Auto" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}" CommandParameter="Auto"/>
