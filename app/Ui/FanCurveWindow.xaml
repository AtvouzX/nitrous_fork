<Window x:Class="Nitrous.Ui.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Fan Curve" Height="660" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Line Gradient -->
        <LinearGradientBrush x:Key="CurveStrokeGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFA500" Offset="0.0" />
            <GradientStop Color="#FF4500" Offset="0.35" />
            <GradientStop Color="#FF4500" Offset="0.70" />
            <GradientStop Color="#FF4500" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Tooltip Drop Shadow -->
        <DropShadowEffect x:Key="PurpleGlowLine" Color="#FF4500" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
        <DropShadowEffect x:Key="PurpleGlowTooltip" Color="#FF4500" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="25" ShadowDepth="10" Opacity="0.6" />

        <Style x:Key="TabPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="20,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF4500" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="14" Height="14" Background="#151518" BorderBrush="#334155"
                                    BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L6,10 L11,3" Stroke="#FF4500" StrokeThickness="2"
                                      Stretch="Uniform" Margin="1" Visibility="Collapsed" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="Foreground" Value="#e2e8f0" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="7000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                MaxWidth="280">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Fill="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="Background" Value="#1E1E22" />
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#FF4500" />
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#151518" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,3,20,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ComboBoxToggleButton}" />
                            <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                <Border x:Name="dropDownBorder" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#151518" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E22" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E22" />
                                <Setter Property="Foreground" Value="#FF4500" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#151518" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1E1E22" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF4500" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" Margin="20">
        <!-- Main Card -->
        <Border Background="#0C0C0E" CornerRadius="18" BorderBrush="#222226" BorderThickness="1.2"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="26,24,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Propeller Icon -->
                        <Grid Width="24" Height="24" Margin="0,0,12,0">
                            <Ellipse Stroke="#334155" StrokeThickness="1.2" />
                            <Ellipse Width="6" Height="6" Fill="#FF4500" />
                            <Path
                                Data="M12 9a3 3 0 0 1 3-3c1.5 0 2 1.5 1 3l-3 1 M15 12a3 3 0 0 1 3 3c0 1.5-1.5 2-3 1l-1-3 M12 15a3 3 0 0 1-3 3c-1.5 0-2-1.5-1-3l3-1 M9 12a3 3 0 0 1-3-3c0-1.5 1.5-2 3-1l1 3"
                                Stroke="#FF4500" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="Custom Fan Curve" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Tabs & Close Button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Profile Selector -->
                        <Border x:Name="ProfileSelectorContainer" Background="#0A0A0C" BorderBrush="#1d2433" BorderThickness="1" CornerRadius="8"
                                Padding="3" Margin="0,0,15,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ProfileQuiet" Content="Quiet"
                                             Style="{StaticResource TabPillStyle}" Checked="Profile_Checked"
                                             ToolTip="Edit fan curve for Quiet mode." />
                                <RadioButton x:Name="ProfileBalanced" Content="Balanced"
                                             Style="{StaticResource TabPillStyle}" Checked="Profile_Checked"
                                             ToolTip="Edit fan curve for Balanced mode." />
                                <RadioButton x:Name="ProfilePerformance" Content="Performance"
                                             Style="{StaticResource TabPillStyle}" Checked="Profile_Checked"
                                             ToolTip="Edit fan curve for Performance mode." />
                            </StackPanel>
                        </Border>

                        <Border Background="#0A0A0C" BorderBrush="#1d2433" BorderThickness="1" CornerRadius="8"
                                Padding="3" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabCpu" Content="CPU" IsChecked="True"
                                             Style="{StaticResource TabPillStyle}" Checked="Tab_Checked"
                                             ToolTip="Switch to CPU fan temperature-to-speed curve waypoints." />
                                <RadioButton x:Name="TabGpu" Content="GPU" Style="{StaticResource TabPillStyle}"
                                             Checked="Tab_Checked"
                                             ToolTip="Switch to GPU fan temperature-to-speed curve waypoints." />
                            </StackPanel>
                        </Border>

                        <!-- Fixed Close Button -->
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                Foreground="#A1A1AA" Cursor="Hand" Click="CloseBtn_Click"
                                ToolTip="Close fan curve editor.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}" FontSize="16"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1E1E22" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- GRAPH AREA -->
                <Border Grid.Row="1" Background="#000000" CornerRadius="12" BorderBrush="#222226" BorderThickness="1"
                        Margin="0,0,0,25">
                    <Grid Margin="15,20,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>

                        <!-- Y-Axis Labels -->
                        <Grid Grid.Column="0" Grid.Row="0" Margin="0,-7,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="100%" Foreground="#A1A1AA" FontSize="10"
                                       FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="1" Text="75%" Foreground="#71717A" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="2" Text="50%" Foreground="#71717A" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="3" Text="25%" Foreground="#71717A" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <!-- 0% label at absolute bottom -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="0%" Foreground="#A1A1AA" FontSize="10"
                                   FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,5,-7" />

                        <!-- PLOT AREA -->
                        <Grid Grid.Column="1" Grid.Row="0">
                            <!-- Horizontal Grid Lines -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="#1A1A1C" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="1" BorderBrush="#1A1A1C" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="2" BorderBrush="#1A1A1C" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="3" BorderBrush="#1A1A1C" BorderThickness="0,1,0,0" />
                            </Grid>
                            <!-- Baseline 0% line -->
                            <Border BorderBrush="#222226" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />

                            <!-- Vertical Grid Lines (30, 45, 60, 75, 90, 100) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="10*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#1A1A1C" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="1" BorderBrush="#1A1A1C" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="2" BorderBrush="#1A1A1C" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="3" BorderBrush="#1A1A1C" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="4" BorderBrush="#1A1A1C" BorderThickness="1,0,1,0" />
                            </Grid>

                            <!-- Canvas -->
                            <Canvas x:Name="GraphCanvas" ClipToBounds="False" MouseMove="GraphCanvas_MouseMove"
                                    MouseUp="GraphCanvas_MouseUp" MouseLeave="GraphCanvas_MouseLeave"
                                    Background="Transparent">
                                <Polyline x:Name="CurveLine" Stroke="{StaticResource CurveStrokeGrad}"
                                          StrokeThickness="3" StrokeLineJoin="Round" IsHitTestVisible="False"
                                          Effect="{StaticResource PurpleGlowLine}" />
                                <Border x:Name="NodeTooltip" Visibility="Hidden" Background="#140f22"
                                        BorderBrush="#FF4500" BorderThickness="1.2" CornerRadius="6" Padding="10,4"
                                        Panel.ZIndex="999" Effect="{StaticResource PurpleGlowTooltip}"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#FF4500" Margin="0,0,6,0" />
                                        <TextBlock x:Name="TooltipText" Text="68°C Â· 43%" Foreground="#FFFFFF"
                                                   FontSize="11.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- X-Axis Labels -->
                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="10*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="30°C" Foreground="#A1A1AA" FontSize="10.5"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                            <TextBlock Grid.Column="1" Text="45°C" Foreground="#A1A1AA" FontSize="10.5"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="60°C" Foreground="#A1A1AA" FontSize="10.5"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                            <TextBlock Grid.Column="3" Text="75°C" Foreground="#A1A1AA" FontSize="10.5"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                            <TextBlock Grid.Column="4" Text="90°C" Foreground="#A1A1AA" FontSize="10.5"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                            <TextBlock Grid.Column="4" Text="100°C" Foreground="#FF4500" FontSize="10.5"
                                       FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,-15,0" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- OPTIONS DOCK -->
                <Grid Grid.Row="2" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="TogSnapToGrid" Content="Snap to Grid (5% / 5°C)" IsChecked="True"
                                  Style="{StaticResource SimpleCheckBoxStyle}"
                                  ToolTip="Snaps waypoints to 5°C temperature and 5% fan speed intervals while dragging." />
                        
                        <CheckBox x:Name="TogUseCustomPreset" Content="Use custom preset" Style="{StaticResource SimpleCheckBoxStyle}" Checked="TogUseCustomPreset_Checked" Unchecked="TogUseCustomPreset_Unchecked" Margin="25,0,0,0" ToolTip="Override power profile curves and use a distinct fan preset."/>
                        
                        <!-- Preset Selection Mode -->
                        <StackPanel x:Name="PresetViewPanel" Orientation="Horizontal">
                            <ComboBox x:Name="PresetCombo" Width="110" Height="26" SelectionChanged="PresetCombo_SelectionChanged" 
                                      Style="{StaticResource DarkComboBoxStyle}" FontSize="12" FontWeight="SemiBold"
                                      VerticalContentAlignment="Center" Margin="10,0,0,0" ToolTip="Select the custom fan preset." MaxDropDownHeight="160">
                            </ComboBox>
                            <Button x:Name="AddPresetBtn" Content="+" Width="24" Height="24" Margin="4,0,0,0" Click="AddPresetBtn_Click" 
                                    Style="{StaticResource IconButtonStyle}" ToolTip="Create a new custom preset"/>
                            <Button x:Name="RenPresetBtn" Content="✎" Width="24" Height="24" Margin="4,0,0,0" Click="RenPresetBtn_Click" 
                                    Style="{StaticResource IconButtonStyle}" ToolTip="Rename current preset"/>
                            <Button x:Name="DelPresetBtn" Content="-" Width="24" Height="24" Margin="4,0,0,0" Click="DelPresetBtn_Click" 
                                    Style="{StaticResource IconButtonStyle}" ToolTip="Delete current preset"/>
                        </StackPanel>

                        <!-- Preset Rename Mode -->
                        <StackPanel x:Name="PresetRenamePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBox x:Name="RenameTextBox" Width="110" Height="26" Background="#151518" Foreground="White" BorderBrush="#FF4500" BorderThickness="1" 
                                     VerticalContentAlignment="Center" Padding="4,0" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                     KeyDown="RenameTextBox_KeyDown"/>
                            <Button x:Name="ConfirmRenameBtn" Content="✔" Width="24" Height="24" Margin="4,0,0,0" Click="ConfirmRenameBtn_Click" 
                                    Style="{StaticResource IconButtonStyle}" Foreground="#34C759" ToolTip="Save new name"/>
                            <Button x:Name="CancelRenameBtn" Content="✕" Width="24" Height="24" Margin="4,0,0,0" Click="CancelRenameBtn_Click" 
                                    Style="{StaticResource IconButtonStyle}" Foreground="#FF453A" ToolTip="Cancel"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#1E1E22" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <Grid>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Tip: Drag any waypoint circle to adjust temperature thresholds."
                                       Foreground="#A1A1AA" FontSize="11.5" />
                            <TextBlock x:Name="WarningTempTextBlock" Text="Warning: Using a Quiet curve on Performance mode may cause overheating." 
                                       Foreground="#FF453A" FontSize="11.5" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset to Defaults" Click="ResetBtn_Click" Foreground="#FF4500"
                                    Cursor="Hand" Margin="0,0,15,0"
                                    ToolTip="Reverts CPU and GPU waypoints to default acoustic curves.">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}" FontSize="12"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1E1E22" />
                                                <Setter Property="Foreground" Value="#FF4500" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="SAVE &amp; APPLY" Click="SaveBtn_Click" Foreground="#ffffff" FontSize="12"
                                    FontWeight="Heavy" Height="36" Width="140" Cursor="Hand"
                                    ToolTip="Saves the curve waypoints to the registry and applies the active fan curve immediately.">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#FF4500" CornerRadius="6">
                                            <Grid>
                                                <!-- Subtle 15% white overlay for a premium hover effect -->
                                                <Border x:Name="HoverOverlay" Background="White" Opacity="0"
                                                        CornerRadius="6" />
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>



