<Window x:Class="Nitrous.Ui.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nitrous.Ui.Controls"
        Title="Custom Fan Curve" Height="660" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nitrous;component/Ui/Styles/DashboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Ember curve stroke (Ignite tokens, flat — no glow effects) -->
            <LinearGradientBrush x:Key="CurveStrokeGrad" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#E85D2A" Offset="0.0" />
                <GradientStop Color="#D94E1F" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Steel ComboBox toggle (zero radius, Ignite tokens) -->
            <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="arrow" Grid.Column="1" Fill="{StaticResource Steel400Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="true">
                        <Setter TargetName="templateRoot" Property="Background" Value="{StaticResource Steel800Brush}" />
                        <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource Steel500Brush}" />
                        <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Steel100Brush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
                <Setter Property="Background" Value="{StaticResource Steel850Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="8,3,20,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                                <ToggleButton x:Name="toggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ComboBoxToggleButton}" />
                                <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Popup x:Name="PART_Popup" AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                    <Border x:Name="dropDownBorder" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1" CornerRadius="0" Margin="0,4,0,0">
                                        <ScrollViewer x:Name="DropDownScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Steel400Brush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Steel800Brush}" />
                                    <Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Steel800Brush}" />
                                    <Setter Property="Foreground" Value="{StaticResource Ember400Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Chamfered window shell (matches NitrousDashboard) -->
    <Grid x:Name="WindowRoot" Background="Transparent">
        <Path x:Name="WindowShellFrame"
              Stroke="{StaticResource Steel600Brush}"
              StrokeThickness="1"
              Fill="{StaticResource Steel900Brush}"
              SnapsToDevicePixels="True" />

        <Grid x:Name="WindowContentGrid" Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Title Bar (recessed Steel950 with 1px bottom border) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="{StaticResource Steel950Brush}">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Steel700Brush}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                     <TextBlock Text="FAN CURVE" Foreground="{StaticResource Steel100Brush}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold"
                               VerticalAlignment="Center" />
                   </StackPanel>

                <!-- Close Button (Anvil Box) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="CloseBtn" Width="24" Height="24"
                            Click="CloseBtn_Click" Cursor="Hand"
                            ToolTip="Close without saving changes.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBorder"
                                        Background="{StaticResource Steel850Brush}"
                                        BorderBrush="{StaticResource Steel700Brush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="CloseIcon"
                                          Data="M6,18L18,6M6,6L18,18"
                                          Stroke="{StaticResource Steel400Brush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource Steel800Brush}" />
                                        <Setter TargetName="CloseBorder" Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
                                        <Setter TargetName="CloseIcon" Property="Stroke" Value="{StaticResource Steel100Brush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Content (Steel900 main surface) -->
            <Grid Grid.Row="1" Background="{StaticResource Steel900Brush}">
                <StackPanel Margin="12,8,12,10">

                    <!-- CURVE CARD -->
                    <controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource BorderCardBrush}"
                                          BorderThickness="1" ChamferSize="6" Padding="12,10,12,12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Card Header with Bottom Divider -->
                            <Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="TEMPERATURE CURVE" Foreground="{StaticResource Steel300Brush}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Profile + Target Detent Rails -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Editing Profile Rail -->
                                <controls:ChamferCard x:Name="ProfileSelectorContainer" Grid.Column="0"
                                                      Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}"
                                                      BorderThickness="1" ChamferSize="4" Padding="0">
                                    <controls:ChamferCard.Style>
                                        <Style TargetType="controls:ChamferCard">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.3" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:ChamferCard.Style>
                                    <UniformGrid Rows="1" Height="34">
                                        <RadioButton x:Name="ProfileQuiet" TabIndex="0" GroupName="FanProfile" Content="Quiet"
                                                     Style="{StaticResource CompactActionButtonStyle}" Checked="Profile_Checked" />
                                        <RadioButton x:Name="ProfileBalanced" TabIndex="1" GroupName="FanProfile" Content="Balanced"
                                                     Style="{StaticResource CompactActionButtonStyle}" Checked="Profile_Checked" />
                                        <RadioButton x:Name="ProfilePerformance" TabIndex="1" GroupName="FanProfile" Content="Performance"
                                                     Style="{StaticResource CompactActionButtonStyle}" Checked="Profile_Checked" />
                                    </UniformGrid>
                                </controls:ChamferCard>

                                <!-- CPU / GPU Target Rail -->
                                <controls:ChamferCard Grid.Column="2"
                                                      Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}"
                                                      BorderThickness="1" ChamferSize="4" Padding="0">
                                    <UniformGrid Rows="1" Height="34">
                                        <RadioButton x:Name="TabCpu" TabIndex="0" GroupName="FanTarget" Content="CPU" IsChecked="True"
                                                     Style="{StaticResource CompactActionButtonStyle}" Checked="Tab_Checked" />
                                        <RadioButton x:Name="TabGpu" TabIndex="1" GroupName="FanTarget" Content="GPU"
                                                     Style="{StaticResource CompactActionButtonStyle}" Checked="Tab_Checked" />
                                    </UniformGrid>
                                </controls:ChamferCard>
                            </Grid>

                            <!-- Graph Well (recessed Steel900) -->
                            <controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel700Brush}"
                                                  BorderThickness="1" ChamferSize="4" Padding="14,12,16,10">
                                <Grid Height="290">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="25" />
                                    </Grid.RowDefinitions>

                                    <!-- Y-Axis Labels -->
                                    <Grid Grid.Column="0" Grid.Row="0" Margin="0,-7,5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="100%" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Right" VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="1" Text="75%" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Right" VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="2" Text="50%" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Right" VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="3" Text="25%" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Right" VerticalAlignment="Top" />
                                    </Grid>
                                    <!-- 0% label at absolute bottom -->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="0%" Foreground="{StaticResource Steel400Brush}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                               TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,-7" />

                                    <!-- PLOT AREA -->
                                    <Grid Grid.Column="1" Grid.Row="0">
                                        <!-- Horizontal Grid Lines -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,1,0,0" />
                                            <Border Grid.Row="1" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,1,0,0" />
                                            <Border Grid.Row="2" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,1,0,0" />
                                            <Border Grid.Row="3" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,1,0,0" />
                                        </Grid>
                                        <!-- Baseline 0% line -->
                                        <Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />

                                        <!-- Vertical Grid Lines (30, 45, 60, 75, 90, 100) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="10*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="1,0,0,0" />
                                            <Border Grid.Column="1" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="1,0,0,0" />
                                            <Border Grid.Column="2" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="1,0,0,0" />
                                            <Border Grid.Column="3" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="1,0,0,0" />
                                            <Border Grid.Column="4" BorderBrush="{StaticResource Steel800Brush}" BorderThickness="1,0,1,0" />
                                        </Grid>

                                        <!-- Canvas -->
                                        <Canvas x:Name="GraphCanvas" ClipToBounds="False" MouseMove="GraphCanvas_MouseMove"
                                                MouseUp="GraphCanvas_MouseUp" MouseLeave="GraphCanvas_MouseLeave"
                                                Background="Transparent">
                                            <Polyline x:Name="CurveLine" Stroke="{StaticResource CurveStrokeGrad}"
                                                      StrokeThickness="2.5" StrokeLineJoin="Round" IsHitTestVisible="False" />
                                            <Border x:Name="NodeTooltip" Visibility="Hidden" Background="{StaticResource Steel950Brush}"
                                                    BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1" CornerRadius="0" Padding="8,4"
                                                    Panel.ZIndex="999" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Ember500Brush}" Margin="0,0,6,0" />
                                                    <TextBlock x:Name="TooltipText" Text="68°C · 43%" Foreground="{StaticResource Steel100Brush}"
                                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" />
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </Grid>

                                    <!-- X-Axis Labels -->
                                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="10*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="30°C" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="-12,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="45°C" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="-12,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="60°C" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="-12,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="75°C" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="-12,0,0,0" />
                                        <TextBlock Grid.Column="4" Text="90°C" Foreground="{StaticResource Steel400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="-12,0,0,0" />
                                        <TextBlock Grid.Column="4" Text="100°C" Foreground="{StaticResource Ember400Brush}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Margin="0,0,-15,0" />
                                    </Grid>
                                </Grid>
                            </controls:ChamferCard>
                        </StackPanel>
                    </controls:ChamferCard>

                    <!-- PRESETS CARD -->
                    <controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource BorderCardBrush}"
                                          BorderThickness="1" ChamferSize="6" Padding="12,10,12,12">
                        <StackPanel>
                            <!-- Card Header with Bottom Divider -->
                            <Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
                                <TextBlock Text="PRESETS" Foreground="{StaticResource Steel300Brush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="TogSnapToGrid" Content="Snap to Grid (5% / 5°C)" IsChecked="True"
                                              Style="{StaticResource SquareCheckBoxStyle}" Foreground="{StaticResource Steel400Brush}"
                                              VerticalAlignment="Center" />
                                    <CheckBox x:Name="TogUseCustomPreset" Content="Use custom preset"
                                              Style="{StaticResource SquareCheckBoxStyle}" Foreground="{StaticResource Steel400Brush}"
                                              VerticalAlignment="Center" Margin="20,0,0,0"
                                              Checked="TogUseCustomPreset_Checked" Unchecked="TogUseCustomPreset_Unchecked"
                                              ToolTip="Override per-profile curves with this preset." />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Preset Selection Mode -->
                                    <StackPanel x:Name="PresetViewPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="PresetCombo" Width="140" Height="26" SelectionChanged="PresetCombo_SelectionChanged"
                                                  Style="{StaticResource DarkComboBoxStyle}" VerticalContentAlignment="Center" MaxDropDownHeight="160" />
                                        <Button x:Name="AddPresetBtn" Content="+" Width="26" Height="26" Margin="6,0,0,0" Click="AddPresetBtn_Click"
                                                Style="{StaticResource GhostBtn}" FontSize="13" ToolTip="Create a new preset." />
                                        <Button x:Name="RenPresetBtn" Content="✎" Width="26" Height="26" Margin="6,0,0,0" Click="RenPresetBtn_Click"
                                                Style="{StaticResource GhostBtn}" FontSize="11" ToolTip="Rename this preset." />
                                        <Button x:Name="DelPresetBtn" Content="–" Width="26" Height="26" Margin="6,0,0,0" Click="DelPresetBtn_Click"
                                                Style="{StaticResource GhostBtn}" FontSize="13" ToolTip="Delete this preset." />
                                    </StackPanel>

                                    <!-- Preset Rename Mode -->
                                    <StackPanel x:Name="PresetRenamePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBox x:Name="RenameTextBox" Width="140" Height="26" Style="{StaticResource HotkeyTextBoxStyle}"
                                                 VerticalContentAlignment="Center" FontSize="11" KeyDown="RenameTextBox_KeyDown" />
                                        <Button x:Name="ConfirmRenameBtn" Content="✔" Width="26" Height="26" Margin="6,0,0,0" Click="ConfirmRenameBtn_Click"
                                                Style="{StaticResource GhostBtn}" FontSize="11" Foreground="#34C759" />
                                        <Button x:Name="CancelRenameBtn" Content="✕" Width="26" Height="26" Margin="6,0,0,0" Click="CancelRenameBtn_Click"
                                                Style="{StaticResource GhostBtn}" FontSize="11" Foreground="#FF453A" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </controls:ChamferCard>

                    <!-- Overheat Warning Banner -->
                    <controls:ChamferCard x:Name="WarningBanner" ChamferSize="4" Background="#201214" BorderBrush="#FF453A"
                                          BorderThickness="1" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M12,2L1,21H23L12,2Z M11,10V14H13V10H11M11,16V18H13V16H11Z"
                                  Fill="#FF453A" Stretch="Uniform" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="WarningTempTextBlock" Grid.Column="1" Text="Warning: Using a Quiet curve on Performance mode may cause overheating."
                                       Foreground="#FF453A" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </controls:ChamferCard>

                </StackPanel>
            </Grid>

            <!-- 3. Bottom Action Bar (Steel950 with 1px top border) -->
            <Border Grid.Row="2" Background="{StaticResource Steel950Brush}"
                    BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="DRAG NODES TO RESHAPE THE CURVE"
                               Foreground="{StaticResource Steel400Brush}" FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:ChamferButton x:Name="ResetBtn" Variant="Secondary" Content="RESET" Width="110" Height="36"
                                                FontSize="11" Margin="0,0,10,0" Click="ResetBtn_Click"
                                                ToolTip="Restore the active curve to stock defaults." />
                        <controls:ChamferButton x:Name="SaveBtn" Variant="Primary" Content="SAVE &amp; APPLY" Width="150" Height="36"
                                                FontSize="11" Click="SaveBtn_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
