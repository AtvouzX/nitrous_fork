<Window x:Class="Nitrous.Ui.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Fan Curve" Height="680" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Line Gradient -->
        <LinearGradientBrush x:Key="CurveStrokeGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#38bdf8" Offset="0.0"/>
            <GradientStop Color="#a855f7" Offset="0.35"/>
            <GradientStop Color="#c084fc" Offset="0.70"/>
            <GradientStop Color="#f43f5e" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Tooltip Drop Shadow -->
        <DropShadowEffect x:Key="PurpleGlowLine" Color="#a855f7" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        <DropShadowEffect x:Key="PurpleGlowTooltip" Color="#a855f7" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="25" ShadowDepth="10" Opacity="0.6"/>

        <Style x:Key="TabPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="20,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1f1133"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#8b5cf6"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#f5f3ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="14" Height="14" Background="#0d1017" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L6,10 L11,3" Stroke="#c084fc" StrokeThickness="2" Stretch="Uniform" Margin="1" Visibility="Collapsed"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#f5f3ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SyncToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Icon" Data="M6,3H8A2,2 0 0,1 10,5V7A2,2 0 0,1 8,9H6 M4,7H2A2,2 0 0,1 0,5V3A2,2 0 0,1 2,1H4" Stroke="#64748b" StrokeThickness="1.4" Stretch="Uniform" Width="12" Height="10" Margin="0,0,6,0"/>
                                <TextBlock Text="Sync" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1f1133"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#8b5cf6"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#f5f3ff"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="#f5f3ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" Margin="20">
        <!-- Main Card -->
        <Border Background="#121622" CornerRadius="18" BorderBrush="#1d2332" BorderThickness="1.2" Effect="{StaticResource CardShadow}">
            <Grid Margin="26,24,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Propeller Icon -->
                        <Grid Width="24" Height="24" Margin="0,0,12,0">
                            <Ellipse Stroke="#334155" StrokeThickness="1.2"/>
                            <Ellipse Width="6" Height="6" Fill="#c084fc"/>
                            <Path Data="M12 9a3 3 0 0 1 3-3c1.5 0 2 1.5 1 3l-3 1 M15 12a3 3 0 0 1 3 3c0 1.5-1.5 2-3 1l-1-3 M12 15a3 3 0 0 1-3 3c-1.5 0-2-1.5-1-3l3-1 M9 12a3 3 0 0 1-3-3c0-1.5 1.5-2 3-1l1 3" Stroke="#c084fc" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                        </Grid>
                        <TextBlock Text="Custom Fan Curve" Foreground="#f8fafc" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tabs & Close Button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#0b0e15" BorderBrush="#1d2433" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabCpu" Content="CPU" IsChecked="True" Style="{StaticResource TabPillStyle}" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabGpu" Content="GPU" Style="{StaticResource TabPillStyle}" Checked="Tab_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- Fixed Close Button -->
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#64748b" Cursor="Hand" Click="CloseBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="16" FontWeight="Bold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1A1F2E"/>
                                            <Setter Property="Foreground" Value="#f8fafc"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- GRAPH AREA -->
                <Border Grid.Row="1" Background="#090c13" CornerRadius="12" BorderBrush="#19202f" BorderThickness="1" Margin="0,0,0,25">
                    <Grid Margin="15,20,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <!-- Y-Axis Labels -->
                        <Grid Grid.Column="0" Grid.Row="0" Margin="0,-7,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="100%" Foreground="#64748b" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="75%" Foreground="#475569" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="50%" Foreground="#475569" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="25%" Foreground="#475569" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                        <!-- 0% label at absolute bottom -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="0%" Foreground="#64748b" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,-7"/>

                        <!-- PLOT AREA -->
                        <Grid Grid.Column="1" Grid.Row="0">
                            <!-- Horizontal Grid Lines -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="#141924" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="1" BorderBrush="#141924" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="2" BorderBrush="#141924" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="3" BorderBrush="#141924" BorderThickness="0,1,0,0"/>
                            </Grid>
                            <!-- Baseline 0% line -->
                            <Border BorderBrush="#1c2333" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                            <!-- Vertical Grid Lines (30, 45, 60, 75, 90, 100) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="10*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#121722" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="1" BorderBrush="#121722" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="2" BorderBrush="#121722" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="3" BorderBrush="#121722" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="4" BorderBrush="#121722" BorderThickness="1,0,1,0"/>
                            </Grid>

                            <!-- Canvas -->
                            <Canvas x:Name="GraphCanvas" ClipToBounds="False" MouseMove="GraphCanvas_MouseMove" MouseUp="GraphCanvas_MouseUp" MouseLeave="GraphCanvas_MouseLeave" Background="Transparent">
                                <Polyline x:Name="CurveLine" Stroke="{StaticResource CurveStrokeGrad}" StrokeThickness="3" StrokeLineJoin="Round" IsHitTestVisible="False" Effect="{StaticResource PurpleGlowLine}"/>
                                <Border x:Name="NodeTooltip" Visibility="Hidden" Background="#140f22" BorderBrush="#a855f7" BorderThickness="1.2" CornerRadius="6" Padding="10,4" Panel.ZIndex="999" Effect="{StaticResource PurpleGlowTooltip}" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#a855f7" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TooltipText" Text="68°C · 43%" Foreground="#f5f3ff" FontSize="11.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- X-Axis Labels -->
                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="10*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="30°C" Foreground="#64748b" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="45°C" Foreground="#64748b" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="60°C" Foreground="#64748b" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="75°C" Foreground="#64748b" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="90°C" Foreground="#64748b" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="100°C" Foreground="#f43f5e" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,-15,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OPTIONS DOCK -->
                <Grid Grid.Row="2" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="TogEnableCurve" Content="Enable Curve Override" IsChecked="{Binding IsCurveModeEnabled}" Style="{StaticResource SimpleCheckBoxStyle}"/>
                        <CheckBox x:Name="TogSnapToGrid" Content="Snap to Grid (5% / 5°C)" IsChecked="True" Margin="25,0,0,0" Style="{StaticResource SimpleCheckBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#171d2b" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <Grid>
                        <TextBlock Text="Tip: Drag any waypoint circle to adjust temperature thresholds." Foreground="#64748b" FontSize="11.5" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset to Defaults" Click="ResetBtn_Click" Foreground="#a855f7" Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,25,0"/>

                            <Button Content="SAVE &amp; APPLY" Click="SaveBtn_Click" Foreground="#ffffff" FontSize="12" FontWeight="Heavy" Height="36" Width="140" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BgBorder" Background="#a855f7" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BgBorder" Property="Background" Value="#c084fc"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
