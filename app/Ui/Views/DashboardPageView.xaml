<UserControl x:Class="Nitrous.Ui.Views.DashboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<StackPanel Margin="12,8,12,0">
		<!-- DASHBOARD GRAPH & TELEMETRY -->
		<Grid Margin="0,0,0,10" Height="172">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="8" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- CPU Graph & Telemetry -->
			<controls:ChamferCard Grid.Column="0" Background="{StaticResource Steel900Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      ChamferSize="6" Padding="12,10,12,10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,6">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Foreground="#A1A1AA" FontSize="10.5" FontWeight="Bold">
								<Run Text="CPU" />
								<Run Text=" • " Foreground="#55555C" />
								<Run Text="{Binding CpuUsageText}" />
							</TextBlock>
							<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
								<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
								      Data="M9,2V4H15V2H17V4H19A2,2 0 0,1 21,6V8H23V10H21V16H23V18H21V20A2,2 0 0,1 19,22H17V24H15V22H9V24H7V22H5A2,2 0 0,1 3,20V18H1V16H3V10H1V8H3V6A2,2 0 0,1 5,4H7V2H9M5,6V20H19V6H5M7,8H17V18H7V8M9,10H15V16H9V10Z" />
								<TextBlock Text="{Binding CpuRpmText}" Foreground="#A1A1AA" FontSize="10.5" FontWeight="SemiBold" />
							</StackPanel>
						</StackPanel>
						<TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempColor}" FontSize="22" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<Grid Grid.Row="1" x:Name="CpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
					      MouseLeave="Graph_MouseLeave" SizeChanged="Graph_SizeChanged">
						<Grid Margin="0,0,0,2" ClipToBounds="True">
							<Polygon Points="{Binding CpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
							<Polygon Points="{Binding CpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
							<Polyline Points="{Binding CpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
							<Polyline Points="{Binding CpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
						</Grid>
						<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding CpuHoverMargin}"
						        Visibility="{Binding CpuHoverVisibility}" />
						<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel600Brush}"
						        BorderThickness="1" CornerRadius="0" Padding="6"
						        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding CpuTooltipMargin}"
						        Visibility="{Binding CpuHoverVisibility}">
							<StackPanel>
								<TextBlock Text="{Binding CpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
								<StackPanel Orientation="Horizontal" Margin="0,2">
									<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
									<TextBlock Text="{Binding CpuHoverTempStr}" FontSize="11" Foreground="White" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,2">
									<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
									<TextBlock Text="{Binding CpuHoverUsageStr}" FontSize="11" Foreground="White" />
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Grid.Row="2" Text="{Binding CpuMaxStatsText}" Foreground="#A1A1AA" FontSize="9.5" FontWeight="Bold"
					           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0" />
				</Grid>
			</controls:ChamferCard>

			<!-- GPU Graph & Telemetry -->
			<controls:ChamferCard Grid.Column="2" Background="{StaticResource Steel900Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      ChamferSize="6" Padding="12,10,12,10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,6">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Foreground="#A1A1AA" FontSize="10.5" FontWeight="Bold">
								<Run Text="GPU" />
								<Run Text=" • " Foreground="#55555C" />
								<Run Text="{Binding GpuUsageText}" />
							</TextBlock>
							<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
								<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
								      Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19M6,13H11V17H6V13M12,7H16V10H12V7M6,7H11V12H6V7M12,11H16V17H12V11Z" />
								<TextBlock Text="{Binding GpuRpmText}" Foreground="#A1A1AA" FontSize="10.5" FontWeight="SemiBold" />
							</StackPanel>
						</StackPanel>
						<TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempColor}" FontSize="22" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<Grid Grid.Row="1" x:Name="GpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
					      MouseLeave="Graph_MouseLeave" SizeChanged="Graph_SizeChanged">
						<Grid Margin="0,0,0,2" ClipToBounds="True">
							<Polygon Points="{Binding GpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
							<Polygon Points="{Binding GpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
							<Polyline Points="{Binding GpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
							<Polyline Points="{Binding GpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
						</Grid>
						<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding GpuHoverMargin}"
						        Visibility="{Binding GpuHoverVisibility}" />
						<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel600Brush}"
						        BorderThickness="1" CornerRadius="0" Padding="6"
						        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding GpuTooltipMargin}"
						        Visibility="{Binding GpuHoverVisibility}">
							<StackPanel>
								<TextBlock Text="{Binding GpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
								<StackPanel Visibility="{Binding GpuHoverStatsVisibility}">
									<StackPanel Orientation="Horizontal" Margin="0,2">
										<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
										<TextBlock Text="{Binding GpuHoverTempStr}" FontSize="11" Foreground="White" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Margin="0,2">
										<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
										<TextBlock Text="{Binding GpuHoverUsageStr}" FontSize="11" Foreground="White" />
									</StackPanel>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Visibility="{Binding GpuHoverSleepVisibility}">
									<Path Fill="#FF4500" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
									      Data="M12,2A9.91,9.91 0 0,0 9,2.46A10,10 0 0,1 9,21.54A10,10 0 1,0 12,2Z" />
									<TextBlock Text="GPU SLEEPING (D3COLD)" FontSize="11" Foreground="White" />
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Grid.Row="2" Text="{Binding GpuMaxStatsText}" Foreground="#A1A1AA" FontSize="9.5" FontWeight="Bold"
					           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0" />
				</Grid>
			</controls:ChamferCard>
		</Grid>

		<!-- POWER CARD (Ignite Steel/Ember Card with Chamfered Edges and Recessed Detent Rail) -->
		<controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource BorderCardBrush}"
		                      BorderThickness="1"
		                      ChamferSize="6" Padding="12,10,12,12" Margin="0,0,0,10">
			<StackPanel>
				<!-- Card Header with Bottom Divider -->
				<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
					<Grid>
						<TextBlock Text="POWER" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}"
						           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
					</Grid>
				</Border>

				<!-- Detent Rail Outer Well (Chamfered button rail matching ignite.html chamfer-btn-outer) -->
				<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}"
				                      BorderThickness="1"
				                      ChamferSize="4" Padding="0">
					<UniformGrid Rows="1" Height="42">
						<RadioButton x:Name="BtnPowerQuiet" TabIndex="0" GroupName="Power" Uid="Quiet"
						             Content="QUIET" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Quiet"
						             ToolTip="Lowest noise. Processor capped at 85% on AC (80% on battery), CPU boost off." />
						<RadioButton x:Name="BtnPowerBal" TabIndex="1" GroupName="Power" Uid="Balanced"
						             Content="BALANCED" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Balanced"
						             ToolTip="Everyday balance. Processor capped at 99% on AC (95% on battery), CPU boost off to prevent temperature spikes." />
						<RadioButton x:Name="BtnPowerPerf" TabIndex="1" GroupName="Power" Uid="Performance"
						             Content="PERFORMANCE" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Performance"
						             ToolTip="More power. Processor at 100% on AC with CPU boost on (99% on battery, boost off)." />
						<RadioButton x:Name="BtnPowerTurbo" TabIndex="1" GroupName="Power" Uid="Turbo"
						             Content="TURBO" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Turbo"
						             Visibility="{Binding IsTurboSupported, Converter={StaticResource BoolToVis}}"
						             ToolTip="Maximum power. Processor locked at 100% min/max on AC with CPU boost on, fans at full cooling." />
					</UniformGrid>
				</controls:ChamferCard>
			</StackPanel>
		</controls:ChamferCard>

		<!-- REFRESH + FANS GRID (Ignite 2-Column Grid Layout: 5* Refresh and 7* Fans) -->
		<Grid Margin="0,0,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="5*" />
				<ColumnDefinition Width="8" />
				<ColumnDefinition Width="7*" />
			</Grid.ColumnDefinitions>

			<!-- REFRESH CARD (Ignite Steel/Ember Card with Chamfered Edges and Vertical Step Stack) -->
			<controls:ChamferCard Grid.Column="0" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      ChamferSize="6" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Active Badge and Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<Grid>
							<TextBlock Text="REFRESH" Foreground="{StaticResource Steel300Brush}"
							           FontFamily="{StaticResource MonoFontFamily}"
							           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
							<TextBlock Text="{Binding RefreshBadgeText}" Foreground="{StaticResource Ember400Brush}"
							           FontFamily="{StaticResource MonoFontFamily}"
							           FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
						</Grid>
					</Border>

					<!-- Vertical Detent Rail (Chamfered outer well with stacked steps) -->
					<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}"
					                      BorderThickness="1"
					                      ChamferSize="4" Padding="0">
						<StackPanel>
							<RadioButton x:Name="BtnRefreshAuto" TabIndex="0" GroupName="Refresh" Uid="Auto"
							             Content="AUTO" Tag="{Binding AutoRefreshSubtext}"
							             Style="{StaticResource VerticalDetentButtonStyle}" Command="{Binding SetRefreshCommand}"
							             CommandParameter="Auto"
							             ToolTip="Max refresh rate on AC, 60Hz on battery to save power." />
							<RadioButton x:Name="BtnRefresh60" TabIndex="1" GroupName="Refresh" Uid="Hz60"
							             Content="60HZ" Tag="Eco"
							             Style="{StaticResource VerticalDetentButtonStyle}" Command="{Binding SetRefreshCommand}"
							             CommandParameter="Hz60"
							             ToolTip="Lock the panel at 60Hz to reduce power draw." />
							<RadioButton x:Name="BtnRefreshMax" TabIndex="1" GroupName="Refresh" Uid="MaxHz"
							             Content="{Binding MaxRefreshText}" Tag="Max"
							             Style="{StaticResource VerticalDetentButtonStyle}" Command="{Binding SetRefreshCommand}"
							             CommandParameter="MaxHz"
							             ToolTip="Lock the panel at its maximum refresh rate." />
						</StackPanel>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>

			<!-- FANS CARD (Ignite Steel/Ember Card with Dynamic Read/Write Views and Bottom Rail) -->
			<controls:ChamferCard Grid.Column="2" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      ChamferSize="6" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Edit Curve Button and Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<Grid>
							<TextBlock Text="FANS" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}"
							           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
								<!-- USE CURVE toggle (visible when Custom Fan is enabled) -->
								<controls:ChamferButton x:Name="BtnCurveToggle"
								                       Variant="Secondary" ChamferSize="3" Height="20" FontSize="8" Padding="8,0" FontWeight="Bold"
								                       Visibility="{Binding IsCustomFanEnabled, Converter={StaticResource BoolToVis}}"
								                       IsActive="{Binding IsCurveModeEnabled, Mode=OneWay}"
								                       Click="CurveToggle_Click"
								                       Margin="0,0,4,0"
								                       ToolTip="Switch manual fan control between fixed speeds and the temperature curve.">
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<TextBlock Text="CURVE" FontFamily="{StaticResource MonoFontFamily}" FontSize="8" FontWeight="Bold" />
									</StackPanel>
								</controls:ChamferButton>
								<!-- EDIT CURVE Button -->
								<controls:ChamferButton x:Name="BtnEditCurve" Variant="Secondary" ChamferSize="3"
								                       Click="OpenCurveEditor_Click" Height="20" FontSize="8" Padding="8,0"
								                       Margin="0,0,0,0"
								                       ToolTip="Open the temperature curve editor.">
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<TextBlock Text="EDIT CURVE" FontFamily="{StaticResource MonoFontFamily}" FontSize="8" FontWeight="Bold" />
									</StackPanel>
								</controls:ChamferButton>
							</StackPanel>
						</Grid>
					</Border>

					<!-- Middle Fan Speeds Area: Fixed Height (74px) hosting Read View or Write View -->
					<Grid Height="74">
						<!-- Read View (Auto / Max / Curve active) -->
						<StackPanel Visibility="{Binding FanReadViewVisibility}" VerticalAlignment="Center">
							<!-- CPU Read Bar -->
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="32" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Value="{Binding CpuFanPercentage}" Maximum="100"
								             Style="{StaticResource IgniteProgressBarStyle}"
								             Margin="6,0,6,0" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding CpuFanPctText}" Foreground="{StaticResource Steel100Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
							</Grid>

							<!-- GPU Read Bar -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="32" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="GPU" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Value="{Binding GpuFanPercentage}" Maximum="100"
								             Style="{StaticResource IgniteProgressBarStyle}"
								             Margin="6,0,6,0" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding GpuFanPctText}" Foreground="{StaticResource Steel100Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
							</Grid>
						</StackPanel>

						<!-- Write View (Manual fixed sliders) -->
						<StackPanel Visibility="{Binding FanWriteViewVisibility}" VerticalAlignment="Center">
							<!-- CPU Write Slider -->
							<Grid Margin="0,0,0,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="32" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
								<Slider Grid.Column="1" x:Name="CpuFanSlider" Style="{StaticResource ModernSliderStyle}"
								        Minimum="0" Maximum="100" Value="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
								        IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1"
								        Margin="6,0,6,0" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding CpuFanSpeed, StringFormat='{}{0}%'}"
								           Foreground="{StaticResource Ember400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" TextAlignment="Right"
								           VerticalAlignment="Center" />
							</Grid>

							<!-- GPU Write Slider -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="32" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="GPU" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
								<Slider Grid.Column="1" x:Name="GpuFanSlider" Style="{StaticResource ModernSliderStyle}"
								        Minimum="0" Maximum="100" Value="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
								        IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1"
								        Margin="6,0,6,0" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding GpuFanSpeed, StringFormat='{}{0}%'}"
								           Foreground="{StaticResource Ember400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" TextAlignment="Right"
								           VerticalAlignment="Center" />
							</Grid>
						</StackPanel>
					</Grid>

					<!-- Bottom Fan Control Detent Rail (AUTO / MAX / MANUAL) -->
					<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}"
					                      BorderThickness="1"
					                      ChamferSize="4" Padding="0" Margin="0,8,0,0">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnFanAuto" TabIndex="0" GroupName="Fans" Uid="Auto"
							             Content="AUTO" Style="{StaticResource CompactActionButtonStyle}" Command="{Binding SetFanCommand}"
							             CommandParameter="Auto"
							             ToolTip="Return fans to factory EC automatic control." />
							<RadioButton x:Name="BtnFanMax" TabIndex="1" GroupName="Fans" Uid="Max"
							             Content="MAX" Style="{StaticResource CompactActionButtonStyle}" Command="{Binding SetFanCommand}"
							             CommandParameter="Max"
							             ToolTip="Force both fans to 100% RPM." />
							<RadioButton x:Name="BtnFanCustom" TabIndex="1" GroupName="Fans" Uid="Medium"
							             Content="MANUAL" Style="{StaticResource CompactActionButtonStyle}"
							             Command="{Binding SetFanCommand}"
							             CommandParameter="Medium"
							             ToolTip="Set fan speeds manually or via a temperature curve." />
						</UniformGrid>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>
		</Grid>
	</StackPanel>
</UserControl>

