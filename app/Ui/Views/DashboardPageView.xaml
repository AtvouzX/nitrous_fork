<UserControl x:Class="Nitrous.Ui.Views.DashboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<StackPanel Margin="20,10,20,0">
		<!-- DASHBOARD GRAPH & TELEMETRY -->
		<Grid Margin="0,0,0,16" Height="140">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- CPU Graph & Telemetry -->
			<controls:ChamferCard Grid.Column="0" Background="{StaticResource Steel900Brush}"
			                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      ChamferSize="6" Padding="10,8,10,8"
			                      ToolTip="Real-time CPU temperature, usage, and fan speed read directly from the Acer Embedded Controller (EC) and Windows.">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,6">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Foreground="#A1A1AA" FontSize="10" FontWeight="Bold">
								<Run Text="CPU" />
								<Run Text=" • " Foreground="#55555C" />
								<Run Text="{Binding CpuUsageText}" />
							</TextBlock>
							<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
								<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0"
								      Data="M9,2V4H15V2H17V4H19A2,2 0 0,1 21,6V8H23V10H21V16H23V18H21V20A2,2 0 0,1 19,22H17V24H15V22H9V24H7V22H5A2,2 0 0,1 3,20V18H1V16H3V10H1V8H3V6A2,2 0 0,1 5,4H7V2H9M5,6V20H19V6H5M7,8H17V18H7V8M9,10H15V16H9V10Z" />
								<TextBlock Text="{Binding CpuRpmText}" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold" />
							</StackPanel>
						</StackPanel>
						<TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempColor}" FontSize="18" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<Grid Grid.Row="1" x:Name="CpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
					      MouseLeave="Graph_MouseLeave">
						<Polygon Points="{Binding CpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
						<Polygon Points="{Binding CpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
						<Polyline Points="{Binding CpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
						<Polyline Points="{Binding CpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
						<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding CpuHoverMargin}"
						        Visibility="{Binding CpuHoverVisibility}" />
						<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}"
						        BorderThickness="1" CornerRadius="0" Padding="6"
						        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding CpuTooltipMargin}"
						        Visibility="{Binding CpuHoverVisibility}">
							<StackPanel>
								<TextBlock Text="{Binding CpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
								<StackPanel Orientation="Horizontal" Margin="0,2">
									<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
									<TextBlock Text="{Binding CpuHoverTempStr}" FontSize="11" Foreground="White" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,2">
									<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
									<TextBlock Text="{Binding CpuHoverUsageStr}" FontSize="11" Foreground="White" />
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Grid.Row="2" Text="{Binding CpuMaxStatsText}" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"
					           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0" />
				</Grid>
			</controls:ChamferCard>

			<!-- GPU Graph & Telemetry -->
			<controls:ChamferCard Grid.Column="2" Background="{StaticResource Steel900Brush}"
			                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      ChamferSize="6" Padding="10,8,10,8"
			                      ToolTip="Discrete GPU thermals and usage.">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,6">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Foreground="#A1A1AA" FontSize="10" FontWeight="Bold">
								<Run Text="GPU" />
								<Run Text=" • " Foreground="#55555C" />
								<Run Text="{Binding GpuUsageText}" />
							</TextBlock>
							<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
								<Path Fill="#FF4500" Opacity="0.8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0"
								      Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19M6,13H11V17H6V13M12,7H16V10H12V7M6,7H11V12H6V7M12,11H16V17H12V11Z" />
								<TextBlock Text="{Binding GpuRpmText}" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold" />
							</StackPanel>
						</StackPanel>
						<TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempColor}" FontSize="18" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<Grid Grid.Row="1" x:Name="GpuGraphGrid" Background="Transparent" MouseMove="Graph_MouseMove"
					      MouseLeave="Graph_MouseLeave">
						<Polygon Points="{Binding GpuTempFillPoints}" Fill="#FF4500" Opacity="0.15" />
						<Polygon Points="{Binding GpuUsageFillPoints}" Fill="#FFFFFF" Opacity="0.10" />
						<Polyline Points="{Binding GpuTempPoints}" Stroke="#FF4500" StrokeThickness="1.5" />
						<Polyline Points="{Binding GpuUsagePoints}" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.7" />
						<Border Width="1" Background="#A1A1AA" HorizontalAlignment="Left" Margin="{Binding GpuHoverMargin}"
						        Visibility="{Binding GpuHoverVisibility}" />
						<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}"
						        BorderThickness="1" CornerRadius="0" Padding="6"
						        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding GpuTooltipMargin}"
						        Visibility="{Binding GpuHoverVisibility}">
							<StackPanel>
								<TextBlock Text="{Binding GpuHoverTime}" Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,4" />
								<StackPanel Visibility="{Binding GpuHoverStatsVisibility}">
									<StackPanel Orientation="Horizontal" Margin="0,2">
										<Rectangle Width="8" Height="8" Fill="#FF4500" Margin="0,0,4,0" />
										<TextBlock Text="{Binding GpuHoverTempStr}" FontSize="11" Foreground="White" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Margin="0,2">
										<Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,4,0" />
										<TextBlock Text="{Binding GpuHoverUsageStr}" FontSize="11" Foreground="White" />
									</StackPanel>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Visibility="{Binding GpuHoverSleepVisibility}">
									<Path Fill="#FF4500" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
									      Data="M12,2A9.91,9.91 0 0,0 9,2.46A10,10 0 0,1 9,21.54A10,10 0 1,0 12,2Z" />
									<TextBlock Text="GPU SLEEPING (D3COLD)" FontSize="11" Foreground="White" />
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Grid.Row="2" Text="{Binding GpuMaxStatsText}" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"
					           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0" />
				</Grid>
			</controls:ChamferCard>
		</Grid>
		<!-- POWER CARD (Ignite Steel/Ember Card with Chamfered Edges and Recessed Detent Rail) -->
		<controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
		                      ChamferSize="6" Padding="10,8,10,10" Margin="0,0,0,16"
		                      ToolTip="Hardware power profile: controls Acer EC thermal profiles, Windows processor states, wattage limits, and fan acoustics.">
			<StackPanel>
				<!-- Card Header with Bottom Divider -->
				<Border BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,8">
					<Grid>
						<TextBlock Text="POWER" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}"
						           FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
					</Grid>
				</Border>

				<!-- Detent Rail Outer Well (Chamfered button rail matching ignite.html chamfer-btn-outer) -->
				<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1"
				                      ChamferSize="4" Padding="0">
					<UniformGrid Rows="1" Height="36">
						<RadioButton x:Name="BtnPowerQuiet" TabIndex="0" GroupName="Power" Uid="Quiet"
						             Content="QUIET" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Quiet"
						             ToolTip="Quiet Profile: Lowers wattage limits and fan speeds. Windows processor state capped at 85% on AC (80% on DC) with CPU boost disabled for silent, cool operation." />
						<RadioButton x:Name="BtnPowerBal" TabIndex="1" GroupName="Power" Uid="Balanced"
						             Content="BALANCED" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Balanced"
						             ToolTip="Balanced Profile: Balanced fan acoustics and standard performance. Windows processor state set to 99% on AC (95% on DC) with CPU boost disabled to eliminate temperature spikes." />
						<RadioButton x:Name="BtnPowerPerf" TabIndex="1" GroupName="Power" Uid="Performance"
						             Content="PERFORMANCE" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Performance"
						             ToolTip="Performance Profile: Increases wattage limits and fan speeds. Windows processor state set to 100% on AC with aggressive CPU boost enabled (99% on DC, boost disabled)." />
						<RadioButton x:Name="BtnPowerTurbo" TabIndex="1" GroupName="Power" Uid="Turbo"
						             Content="TURBO" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}"
						             CommandParameter="Turbo"
						             Visibility="{Binding IsTurboSupported, Converter={StaticResource BoolToVis}}"
						             ToolTip="Turbo Profile: Maximum cooling and maximum wattage. Windows processor state locked at 100% min/max on AC with aggressive CPU boost enabled." />
					</UniformGrid>
				</controls:ChamferCard>
			</StackPanel>
		</controls:ChamferCard>
		<!-- REFRESH CARD (Ignite Steel/Ember Card with Chamfered Edges and Recessed Detent Rail) -->
		<controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
		                      ChamferSize="6" Padding="10,8,10,10" Margin="0,0,0,16"
		                      ToolTip="Display refresh rate controls: switch between automatic AC/DC rate switching, fixed 60Hz battery saver, or maximum hardware panel refresh rate.">
			<StackPanel>
				<!-- Card Header with Bottom Divider -->
				<Border BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,8">
					<Grid>
						<TextBlock Text="DISPLAY REFRESH" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}"
						           FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
					</Grid>
				</Border>

				<!-- Detent Rail Outer Well (Chamfered button rail matching ignite.html chamfer-btn-outer) -->
				<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1"
				                      ChamferSize="4" Padding="0">
					<UniformGrid Rows="1" Height="36">
						<RadioButton x:Name="BtnRefreshAuto" TabIndex="0" GroupName="Refresh" Uid="Auto"
						             Tag="M12,4V1L7,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6.34,14H4.27A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"
						             Content="AUTO" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}"
						             CommandParameter="Auto"
						             ToolTip="Automatically switches to maximum refresh rate on AC power and 60Hz on battery to save power." />
						<RadioButton x:Name="BtnRefresh60" TabIndex="1" GroupName="Refresh" Uid="Hz60"
						             Tag="M2,12C4.5,6.5 7.5,6.5 10.5,12C13.5,17.5 16.5,17.5 19,12H22C18.5,19.5 14.5,19.5 10.5,14C7.5,8.5 5,8.5 2,12Z"
						             Content="60HZ" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}"
						             CommandParameter="Hz60"
						             ToolTip="Locks display to 60Hz to reduce display panel power consumption." />
						<RadioButton x:Name="BtnRefreshMax" TabIndex="1" GroupName="Refresh" Uid="MaxHz"
						             Tag="M13,2L4,14H11L9,22L20,10H13L15,2Z" Content="{Binding MaxRefreshText}"
						             Style="{StaticResource ActionButtonStyle}" Command="{Binding SetRefreshCommand}"
						             CommandParameter="MaxHz"
						             ToolTip="Forces maximum display refresh rate for fluid, low-latency visuals." />
					</UniformGrid>
				</controls:ChamferCard>
			</StackPanel>
		</controls:ChamferCard>

		<!-- FANS CARD (Ignite Steel/Ember Card with Chamfered Edges and Recessed Detent Rail) -->
		<controls:ChamferCard Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
		                      ChamferSize="6" Padding="10,8,10,10" Margin="0,0,0,16"
		                      ToolTip="Hardware cooling fan controls: toggle factory EC automatic curve, maximum RPM, or custom waypoint temperature fan curves.">
			<StackPanel>
				<!-- Card Header with Bottom Divider -->
				<Border BorderBrush="{StaticResource Steel800Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,8">
					<Grid>
						<TextBlock Text="FANS" Foreground="{StaticResource Steel300Brush}" FontFamily="{StaticResource MonoFontFamily}"
						           FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
					</Grid>
				</Border>

				<!-- Detent Rail Outer Well (Chamfered button rail matching ignite.html chamfer-btn-outer) -->
				<controls:ChamferCard Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1"
				                      ChamferSize="4" Padding="0">
					<UniformGrid Rows="1" Height="36">
						<RadioButton x:Name="BtnFanAuto" TabIndex="0" GroupName="Fans" Uid="Auto"
						             Tag="M12,4V1L7,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6.34,14H4.27A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"
						             Content="AUTO" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}"
						             CommandParameter="Auto"
						             ToolTip="Restores factory Acer Embedded Controller automatic fan management." />
						<RadioButton x:Name="BtnFanMax" TabIndex="1" GroupName="Fans" Uid="Max"
						             Tag="M19.78,20.78 L12.78,15.9 A3,3 0 1,1 14.9,13.78 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z"
						             Content="MAX" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}"
						             CommandParameter="Max" ToolTip="Forces all cooling fans to 100% maximum RPM." />
						<RadioButton x:Name="BtnFanCustom" TabIndex="1" GroupName="Fans" Uid="Medium"
						             Tag="M3,7V9H13V7H3M15,11H17V9H21V7H17V5H15V11ZM3,15V17H9V15H3M13,19V17H21V15H13V13H11V19H13Z"
						             Content="CUSTOM" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}"
						             CommandParameter="Medium"
						             ToolTip="Enables custom fan speed controls and waypoint temperature curves." />
					</UniformGrid>
				</controls:ChamferCard>

				<StackPanel Visibility="{Binding IsCustomFanEnabled, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
					<Grid Margin="0,0,0,12">
						<TextBlock Text="{Binding CustomFanHeaderText}" Foreground="{Binding CustomFanHeaderColor}" FontSize="10"
						           FontWeight="Bold" VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<ToggleButton IsChecked="{Binding IsCurveModeEnabled, UpdateSourceTrigger=PropertyChanged}"
							              IsEnabled="{Binding IsCustomFanEnabled}" Margin="0" Cursor="Hand"
							              ToolTip="Enables active temperature-based fan curve control.">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border x:Name="BgBorder" Background="{StaticResource Steel950Brush}"
										        BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" CornerRadius="0"
										        Padding="6,2">
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<Path x:Name="Indicator"
												      Data="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
												      Fill="#A1A1AA" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" />
												<TextBlock x:Name="Txt" Text="USE CURVE" FontSize="9" FontWeight="Bold" Foreground="#A1A1AA"
												           VerticalAlignment="Center" Margin="0,0,4,0" />
												<Rectangle Width="1" Height="10" Fill="#333338" Margin="2,0,4,0" VerticalAlignment="Center" />
												<Button Click="OpenCurveEditor_Click" Background="Transparent" BorderThickness="0" Padding="2"
												        Cursor="Hand" ToolTip="Opens the interactive fan curve editor.">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border Background="Transparent">
																<Path x:Name="EditIcon"
																      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z"
																      Fill="#A1A1AA" Stretch="Uniform" Width="9" Height="9" />
															</Border>
															<ControlTemplate.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter TargetName="EditIcon" Property="Fill" Value="#FFFFFF" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</StackPanel>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked" Value="True">
												<Setter TargetName="Indicator" Property="Fill" Value="#FF4500" />
												<Setter TargetName="Indicator" Property="Data"
												        Value="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" />
												<Setter TargetName="BgBorder" Property="BorderBrush" Value="#FF4500" />
												<Setter TargetName="Txt" Property="Foreground" Value="White" />
											</Trigger>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="BgBorder" Property="Background" Value="#1E1E22" />
											</Trigger>
											<Trigger Property="IsEnabled" Value="False">
												<Setter TargetName="BgBorder" Property="Opacity" Value="0.3" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
						</StackPanel>
					</Grid>
					<Grid Margin="0,0,0,4">
						<TextBlock Text="CPU FAN SPEED" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left"
						           VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<TextBox x:Name="CpuFanInput" Text="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
							         Foreground="#FF4500" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0"
							         MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center"
							         CaretBrush="#FF4500" IsEnabled="{Binding IsManualSliderEnabled}" />
							<TextBlock Text="%" Foreground="#FF4500" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
						</StackPanel>
					</Grid>
					<Slider x:Name="CpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
					        Value="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
					        IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1"
					        Margin="0,0,0,0" />

					<ToggleButton x:Name="TogUnifiedFans" IsChecked="{Binding IsUnifiedFans, UpdateSourceTrigger=PropertyChanged}"
					              IsEnabled="{Binding IsManualSliderEnabled}" HorizontalAlignment="Center" Margin="0,4,0,0"
					              Cursor="Hand" ToolTip="Locks CPU and GPU fan speeds together to adjust both fans simultaneously.">
						<ToggleButton.Template>
							<ControlTemplate TargetType="ToggleButton">
								<Border Background="Transparent" Padding="4">
									<Path x:Name="LinkIcon"
									      Data="M16,6H13V7.9H16C18.26,7.9 20.1,9.73 20.1,12C20.1,14.26 18.26,16.1 16,16.1H13V18H16C19.31,18 22,15.31 22,12C22,8.68 19.31,6 16,6M3.9,12C3.9,9.73 5.74,7.9 8,7.9H11V6H8C4.69,6 2,8.68 2,12C2,15.31 4.69,18 8,18H11V16.1H8C5.74,16.1 3.9,14.26 3.9,12M8,11H16V12.9H8V11Z"
									      Fill="#A1A1AA" Stretch="Uniform" Width="14" Height="14" />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsChecked" Value="True">
										<Setter TargetName="LinkIcon" Property="Fill" Value="#FF4500" />
									</Trigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="LinkIcon" Property="Opacity" Value="0.8" />
									</Trigger>
									<Trigger Property="IsEnabled" Value="False">
										<Setter TargetName="LinkIcon" Property="Opacity" Value="0.3" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</ToggleButton.Template>
					</ToggleButton>
					<Grid Margin="0,0,0,4">
						<TextBlock Text="GPU FAN SPEED" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left"
						           VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<TextBox x:Name="GpuFanInput" Text="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
							         Foreground="#FF4500" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0"
							         MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center"
							         CaretBrush="#FF4500" IsEnabled="{Binding IsManualSliderEnabled}" />
							<TextBlock Text="%" Foreground="#FF4500" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
						</StackPanel>
					</Grid>
					<Slider x:Name="GpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
					        Value="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}"
					        IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1" />
				</StackPanel>
			</StackPanel>
		</controls:ChamferCard>
	</StackPanel>
</UserControl>

