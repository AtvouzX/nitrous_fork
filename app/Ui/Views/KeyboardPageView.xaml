<UserControl x:Class="Nitrous.Ui.Views.KeyboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Zone Swatch Style (Steel token, zero radius) -->
			<Style x:Key="ZoneSwatchStyle" TargetType="Button">
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Background" Value="{StaticResource Steel850Brush}" />
				<Setter Property="Foreground" Value="White" />
				<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
				<Setter Property="FontSize" Value="10.5" />
				<Setter Property="FontWeight" Value="Bold" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Steel600Brush}" BorderThickness="1" CornerRadius="0">
								<Grid>
									<Border Background="{StaticResource Steel950Brush}" Opacity="0.35" />
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<ScrollViewer Margin="12,8,12,0" VerticalScrollBarVisibility="Hidden"
	              HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0,0,0,12">
		<StackPanel>
			<!-- 1. STICKY KEYS CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<TextBlock Text="ACCESSIBILITY" Foreground="{StaticResource Steel300Brush}" 
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="STICKY KEYS" Foreground="White"
							           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
							<TextBlock Text="Sequential modifier keys for shortcuts" Foreground="{StaticResource Steel400Brush}"
							           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,2,0,0" />
						</StackPanel>
						<CheckBox Grid.Column="1" x:Name="TogStickyKeys" Style="{StaticResource ModernToggleStyle}"
						          HorizontalAlignment="Right" VerticalAlignment="Center"
						          Checked="StickyKeys_Toggled" Unchecked="StickyKeys_Toggled"
						          ToolTip="Toggle Windows Sticky Keys without holding Shift 5 times." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 2. 4-ZONE RGB LIGHTING CARD -->
			<controls:ChamferCard x:Name="CrdKeyboardLighting" ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<Grid>
							<TextBlock Text="RGB LIGHTING" Foreground="{StaticResource Steel300Brush}" 
							           FontFamily="{StaticResource MonoFontFamily}"
							           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
							<TextBlock x:Name="TxtLightingStatus" Foreground="{StaticResource Steel400Brush}"
							           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" FontWeight="Bold"
							           HorizontalAlignment="Right" VerticalAlignment="Center" />
						</Grid>
					</Border>

					<!-- Zone Swatches Grid (Z1, Z2, Z3, Z4, ALL) -->
					<Grid x:Name="GrdZoneSwatches" Margin="0,0,0,12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="6" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="6" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="6" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="6" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Button x:Name="Zone1Btn" Grid.Column="0" Height="36" Tag="1" Click="Zone_Click"
						        Style="{StaticResource ZoneSwatchStyle}" Content="Z1"
						        ToolTip="Select Zone 1 color." />
						<Button x:Name="Zone2Btn" Grid.Column="2" Height="36" Tag="2" Click="Zone_Click"
						        Style="{StaticResource ZoneSwatchStyle}" Content="Z2"
						        ToolTip="Select Zone 2 color." />
						<Button x:Name="Zone3Btn" Grid.Column="4" Height="36" Tag="3" Click="Zone_Click"
						        Style="{StaticResource ZoneSwatchStyle}" Content="Z3"
						        ToolTip="Select Zone 3 color." />
						<Button x:Name="Zone4Btn" Grid.Column="6" Height="36" Tag="4" Click="Zone_Click"
						        Style="{StaticResource ZoneSwatchStyle}" Content="Z4"
						        ToolTip="Select Zone 4 color." />
						<Button x:Name="ZoneAllBtn" Grid.Column="8" Height="36" Tag="0" Click="Zone_Click"
						        Style="{StaticResource ZoneSwatchStyle}" Content="ALL"
						        ToolTip="Set all four zones to one color." />
					</Grid>

					<!-- Effect Row -->
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="LIGHTING EFFECT" Foreground="White"
						           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
						<ComboBox Grid.Column="1" x:Name="KeyboardEffectBox" Width="140" Height="26"
						          Style="{StaticResource CompactComboBoxStyle}"
						          VerticalContentAlignment="Center"
						          SelectionChanged="KeyboardEffect_Changed"
						          ToolTip="Choose static colors or an animated lighting effect." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 3. KEYBOARD BACKLIGHT CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<TextBlock Text="BACKLIGHT" Foreground="{StaticResource Steel300Brush}" 
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<!-- Chamfered Backlight Well -->
					<controls:ChamferCard ChamferSize="4" Background="{StaticResource Steel900Brush}" 
					                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" Padding="14,12">
						<StackPanel>
							<!-- 30S TIMEOUT TOGGLE (brightness level is not a Dashboard setting; Fn+F11 owns it) -->
							<Grid x:Name="GrdTimeoutRow">
								<TextBlock x:Name="TxtTimeoutLabel" Text="30S IDLE TIMEOUT" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<CheckBox x:Name="ChkBacklightTimeout" Style="{StaticResource SquareCheckBoxStyle}" HorizontalAlignment="Right"
								          Checked="ChkBacklightTimeout_Changed" Unchecked="ChkBacklightTimeout_Changed"
								          ToolTip="Automatically turns off backlight after 30 seconds of inactivity." />
							</Grid>
						</StackPanel>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 4. GLOBAL SHORTCUTS CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<TextBlock Text="SHORTCUTS" Foreground="{StaticResource Steel300Brush}" 
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<!-- Chamfered Hotkeys Well -->
					<controls:ChamferCard ChamferSize="4" Background="{StaticResource Steel900Brush}" 
					                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" Padding="14,12">
						<StackPanel>
							<!-- Shortcut Row 1: CYCLE POWER MODE -->
							<Grid Margin="0,0,0,10">
								<TextBlock Text="CYCLE POWER MODE" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<TextBox x:Name="TxtHkCycle" Style="{StaticResource HotkeyTextBoxStyle}" Width="130" Height="28"
								         VerticalContentAlignment="Center" HorizontalAlignment="Right" IsReadOnly="True" TextAlignment="Center"
								         PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Hotkey_CyclePower"
								         ToolTip="Click, then press the key combination to bind. ESC clears." />
							</Grid>

							<Border Height="1" Background="{StaticResource Steel800Brush}" Margin="0,0,0,10" />

							<!-- Shortcut Row 2: OPEN DASHBOARD -->
							<Grid>
								<TextBlock Text="OPEN DASHBOARD" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<TextBox x:Name="TxtHkDash" Style="{StaticResource HotkeyTextBoxStyle}" Width="130" Height="28"
								         VerticalContentAlignment="Center" HorizontalAlignment="Right" IsReadOnly="True" TextAlignment="Center"
								         PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Hotkey_Dashboard"
								         ToolTip="Click, then press the key combination to bind. ESC clears." />
							</Grid>
						</StackPanel>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>
		</StackPanel>
	</ScrollViewer>
</UserControl>
