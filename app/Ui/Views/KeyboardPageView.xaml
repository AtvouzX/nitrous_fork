<UserControl x:Class="Nitrous.Ui.Views.KeyboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<ScrollViewer Margin="12,8,12,0" VerticalScrollBarVisibility="Hidden"
	              HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0,0,0,12">
		<StackPanel>
			<!-- KEYBOARD BACKLIGHT CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<TextBlock Text="BACKLIGHT" Foreground="{StaticResource Steel300Brush}" 
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<!-- Chamfered Backlight Well -->
					<controls:ChamferCard ChamferSize="4" Background="{StaticResource Steel900Brush}" 
					                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" Padding="14,12">
						<StackPanel>
							<!-- Row 1: BRIGHTNESS LEVELS -->
							<Grid Margin="0,0,0,12">
								<TextBlock Text="BRIGHTNESS LEVEL" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
									<controls:ChamferButton x:Name="BtnBacklightOff" Content="OFF" Width="55" Height="26" Margin="0,0,6,0"
									                        Click="BtnBacklightOff_Click"
									                        ToolTip="EC ignores WMI off on this model — press Fn+F11 to turn the light off." />
									<controls:ChamferButton x:Name="BtnBacklightL1" Content="LVL 1" Width="55" Height="26" Margin="0,0,6,0"
									                        Click="BtnBacklightL1_Click"
									                        ToolTip="Dim backlight. Takes effect on next keypress." />
									<controls:ChamferButton x:Name="BtnBacklightL2" Content="LVL 2" Width="55" Height="26"
									                        Click="BtnBacklightL2_Click"
									                        ToolTip="Bright backlight. Takes effect on next keypress." />
								</StackPanel>
							</Grid>

							<Border Height="1" Background="{StaticResource Steel800Brush}" Margin="0,0,0,10" />

							<!-- Row 2: 30S TIMEOUT TOGGLE -->
							<Grid x:Name="GrdTimeoutRow">
								<TextBlock x:Name="TxtTimeoutLabel" Text="30S IDLE TIMEOUT" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<CheckBox x:Name="ChkBacklightTimeout" Style="{StaticResource SquareCheckBoxStyle}" HorizontalAlignment="Right"
								          Checked="ChkBacklightTimeout_Changed" Unchecked="ChkBacklightTimeout_Changed"
								          ToolTip="Automatically turns off backlight after 30 seconds of inactivity." />
							</Grid>
						</StackPanel>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>

			<!-- GLOBAL SHORTCUTS CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}" 
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,12">
						<TextBlock Text="SHORTCUTS" Foreground="{StaticResource Steel300Brush}" 
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<!-- Chamfered Hotkeys Well -->
					<controls:ChamferCard ChamferSize="4" Background="{StaticResource Steel900Brush}" 
					                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" Padding="14,12">
						<StackPanel>
							<!-- Shortcut Row 1: CYCLE POWER MODE -->
							<Grid Margin="0,0,0,10">
								<TextBlock Text="CYCLE POWER MODE" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
								<TextBox x:Name="TxtHkCycle" Style="{StaticResource HotkeyTextBoxStyle}" Width="130" Height="28"
								         VerticalContentAlignment="Center" HorizontalAlignment="Right" IsReadOnly="True" TextAlignment="Center"
								         PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Hotkey_CyclePower"
			         ToolTip="Click, then press the key combination to bind. ESC clears." />
				</Grid>

				<Border Height="1" Background="{StaticResource Steel800Brush}" Margin="0,0,0,10" />

				<!-- Shortcut Row 2: OPEN DASHBOARD -->
				<Grid>
					<TextBlock Text="OPEN DASHBOARD" Foreground="White" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
					<TextBox x:Name="TxtHkDash" Style="{StaticResource HotkeyTextBoxStyle}" Width="130" Height="28"
					         VerticalContentAlignment="Center" HorizontalAlignment="Right" IsReadOnly="True" TextAlignment="Center"
					         PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Hotkey_Dashboard"
					         ToolTip="Click, then press the key combination to bind. ESC clears." />
							</Grid>
						</StackPanel>
					</controls:ChamferCard>
				</StackPanel>
			</controls:ChamferCard>
		</StackPanel>
	</ScrollViewer>
</UserControl>