<UserControl x:Class="Nitrous.Ui.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<ScrollViewer Margin="12,8,12,0" VerticalScrollBarVisibility="Hidden"
	              HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0,0,0,12">
		<StackPanel>
			<!-- 1. APP / SYSTEM INFO BANNER CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,10">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
						<!-- Logo container -->
						<Border Width="34" Height="34" Background="{StaticResource Steel900Brush}"
						        BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
						        Margin="0,0,12,0" VerticalAlignment="Center">
							<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="5"
							       Stretch="Uniform" />
						</Border>

						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="SettingsVersionText" Text="NITROUS"
							           Foreground="White"
							           FontFamily="{StaticResource MonoFontFamily}"
							           FontWeight="Bold" FontSize="12.5" />
							<TextBlock Text="Acer hardware control engine"
							           Foreground="{StaticResource Steel400Brush}"
							           FontFamily="{StaticResource MonoFontFamily}"
							           FontSize="9.5" Margin="0,2,0,0" />
						</StackPanel>
					</StackPanel>

					<!-- Architecture / Build Badge -->
					<Border Grid.Column="1" Background="{StaticResource Steel900Brush}"
					        BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
					        Padding="8,3" VerticalAlignment="Center">
						<TextBlock Text="x64" Foreground="{StaticResource Steel300Brush}"
						           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" FontWeight="Bold" />
					</Border>
				</Grid>
			</controls:ChamferCard>

			<!-- 2. BATTERY MANAGEMENT CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<TextBlock Text="BATTERY" Foreground="{StaticResource Steel300Brush}"
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
					</Border>

					<!-- 3-Column Metrics Well (Chamfered Recessed Deep Steel900 Well) -->
					<controls:ChamferCard ChamferSize="4" Background="{StaticResource Steel900Brush}"
					                      BorderBrush="{StaticResource Steel700Brush}"
					                      BorderThickness="1" Margin="0,0,0,10" Padding="0,8">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="1" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="1" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!-- Health % -->
							<StackPanel Grid.Column="0" HorizontalAlignment="Center">
								<TextBlock Text="HEALTH" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold"
								           HorizontalAlignment="Center" />
								<TextBlock Text="{Binding BatteryHealthPercentText}" Foreground="White"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold"
								           HorizontalAlignment="Center" Margin="0,3,0,0" />
							</StackPanel>

							<!-- Divider 1 -->
							<Border Grid.Column="1" Background="{StaticResource Steel800Brush}" />

							<!-- Capacity mWh -->
							<StackPanel Grid.Column="2" HorizontalAlignment="Center" ToolTip="{Binding BatteryHealthText}">
								<TextBlock Text="mWh" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold"
								           HorizontalAlignment="Center" />
								<TextBlock Text="{Binding BatteryMwhText}" Foreground="{StaticResource Ember400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold"
								           HorizontalAlignment="Center" Margin="0,3,0,0" />
							</StackPanel>

							<!-- Divider 2 -->
							<Border Grid.Column="3" Background="{StaticResource Steel800Brush}" />

							<!-- Cycle Count -->
							<StackPanel Grid.Column="4" HorizontalAlignment="Center">
								<TextBlock Text="CYCLES" Foreground="{StaticResource Steel400Brush}"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold"
								           HorizontalAlignment="Center" />
								<TextBlock Text="{Binding BatteryCycleText}" Foreground="White"
								           FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold"
								           HorizontalAlignment="Center" Margin="0,3,0,0" />
							</StackPanel>
						</Grid>
					</controls:ChamferCard>

					<!-- 20-Segment Battery Charge Block Meter -->
				<controls:BatteryBlockBar Height="8" Margin="0,0,0,12"
				                          ChargePercent="{Binding BatteryChargePercent}"
				                          IsLimit80Active="{Binding ChargeLimit}" />

					<!-- 80% Limit Toggle Row -->
					<Grid Margin="0,2,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="80% CHARGE LIMIT" Foreground="White"
							           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
						</StackPanel>
						<CheckBox Grid.Column="1" x:Name="TogCharge" Style="{StaticResource ModernToggleStyle}"
						          HorizontalAlignment="Right" VerticalAlignment="Center"
						          IsChecked="{Binding ChargeLimit, UpdateSourceTrigger=PropertyChanged}"
						          ToolTip="Cap charging at 80% to extend battery lifespan." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 3. ACER OEM SERVICES CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<TextBlock Text="ACER SERVICES" Foreground="{StaticResource Steel300Brush}"
						           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10"
						           VerticalAlignment="Center" />
					</Border>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
							<ToggleButton x:Name="BtnAcerServicesDetails" HorizontalAlignment="Left"
							              Background="Transparent" BorderThickness="0" Cursor="Hand">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<ContentPresenter />
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
								<StackPanel>
									<TextBlock Text="ACER BACKGROUND SERVICES" Foreground="White"
									           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
									<TextBlock Text="{Binding AcerServicesStatusText}" Foreground="{StaticResource Steel400Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
								</StackPanel>
							</ToggleButton>

							<Popup IsOpen="{Binding IsChecked, ElementName=BtnAcerServicesDetails, Mode=TwoWay}" StaysOpen="False"
							       PlacementTarget="{Binding ElementName=BtnAcerServicesDetails}" Placement="Bottom">
								<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource BorderCardBrush}"
								        BorderThickness="1" Padding="10" Margin="0,4,0,0">
									<ItemsControl ItemsSource="{Binding AcerServicesList}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid Margin="0,2">
										<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Button Grid.Column="0" Style="{StaticResource GhostBtn}" Padding="2" Margin="0,0,6,0"
													        Command="{Binding DataContext.KillAcerServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													        CommandParameter="{Binding ServiceName}"
													        ToolTip="Stop and disable this service.">
														<Path
															Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z"
															Fill="#FF4500" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" />
													</Button>
													<TextBlock Grid.Column="1" Text="{Binding ServiceName}" Foreground="{StaticResource Steel400Brush}"
													           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" VerticalAlignment="Center" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Border>
							</Popup>
						</StackPanel>

						<!-- Primary Action Chamfer Button (Restore / Stop) -->
						<controls:ChamferButton x:Name="BtnAcerServices" Grid.Column="1"
						                        Variant="Primary"
						                        Content="{Binding AcerServicesActionText}"
						                        Command="{Binding ToggleAcerServicesCommand}"
						                        Height="34" MinWidth="110" Padding="14,0"
						                        HorizontalAlignment="Right" VerticalAlignment="Center"
									ToolTip="Stop NitroSense and Acer Care Center to free RAM and prevent OEM fan/profile overrides." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 4. AUTOMATION RULES CARD (2x2 Grid) -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<TextBlock Text="RULES" Foreground="{StaticResource Steel300Brush}"
						           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10"
						           VerticalAlignment="Center" />
					</Border>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- Rule 1: CPU Limits -->
						<controls:ChamferCard Grid.Row="0" Grid.Column="0" ChamferSize="4"
						                      Background="{StaticResource Steel900Brush}"
						                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
						                      Padding="10,8" Height="52">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="CPU Limits" Foreground="White"
									           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
									<TextBlock Text="AC/DC clamps" Foreground="{StaticResource Steel400Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,2,0,0" />
								</StackPanel>
								<CheckBox Grid.Column="1" x:Name="TogManageCpu" Style="{StaticResource ChamferMiniToggleStyle}"
								          IsChecked="{Binding ManageCpuPower, UpdateSourceTrigger=PropertyChanged}"
								          ToolTip="Apply per-profile Windows CPU limits automatically (Quiet 85%, Balanced 99%, Performance/Turbo 100%)."
								          VerticalAlignment="Center" Margin="6,0,0,0" />
							</Grid>
						</controls:ChamferCard>

						<!-- Rule 2: Auto Power Switch -->
						<controls:ChamferCard Grid.Row="0" Grid.Column="2" ChamferSize="4"
						                      Background="{StaticResource Steel900Brush}"
						                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
						                      Padding="10,8" Height="52">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="Auto Power" Foreground="White"
									           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
									<TextBlock Text="AC/DC profile" Foreground="{StaticResource Steel400Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,2,0,0" />
								</StackPanel>
								<CheckBox Grid.Column="1" x:Name="TogAutoSwitch" Style="{StaticResource ChamferMiniToggleStyle}"
								          IsChecked="{Binding AutoSwitch, UpdateSourceTrigger=PropertyChanged}"
								          ToolTip="Switch to the AC profile when plugged in, and the battery profile on DC."
								          VerticalAlignment="Center" Margin="6,0,0,0" />
							</Grid>
						</controls:ChamferCard>

						<!-- Rule 3: GPU Clocks -->
						<controls:ChamferCard Grid.Row="2" Grid.Column="0" ChamferSize="4"
						                      Background="{StaticResource Steel900Brush}"
						                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
						                      Padding="10,8" Height="52">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="GPU Clocks" Foreground="White"
									           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
									<TextBlock Text="Wake offsets" Foreground="{StaticResource Steel400Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,2,0,0" />
								</StackPanel>
								<CheckBox Grid.Column="1" x:Name="TogAutoApplyClocks" Style="{StaticResource ChamferMiniToggleStyle}"
								          IsChecked="{Binding AutoApplyGpuClocks, UpdateSourceTrigger=PropertyChanged}"
								          ToolTip="Reapply saved GPU clock offsets when the GPU wakes from D3Cold sleep on AC power."
								          VerticalAlignment="Center" Margin="6,0,0,0" />
							</Grid>
						</controls:ChamferCard>

						<!-- Rule 4: Run on Startup -->
						<controls:ChamferCard Grid.Row="2" Grid.Column="2" ChamferSize="4"
						                      Background="{StaticResource Steel900Brush}"
						                      BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
						                      Padding="10,8" Height="52">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="Startup" Foreground="White"
									           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
									<TextBlock Text="Logon task" Foreground="{StaticResource Steel400Brush}"
									           FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" Margin="0,2,0,0" />
								</StackPanel>
								<CheckBox Grid.Column="1" x:Name="TogStartup" Style="{StaticResource ChamferMiniToggleStyle}"
								          IsChecked="{Binding RunOnStartup, UpdateSourceTrigger=PropertyChanged}"
								          ToolTip="Start Nitrous in the tray at logon via an elevated scheduled task (no UAC prompt)."
								          VerticalAlignment="Center" Margin="6,0,0,0" />
							</Grid>
						</controls:ChamferCard>
					</Grid>
				</StackPanel>
			</controls:ChamferCard>

			<!-- 5. DIAGNOSTICS & DEBUG CARD -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel950Brush}"
			                      BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
			                      Margin="0,0,0,10" Padding="12,10,12,12">
				<StackPanel>
					<!-- Card Header with Bottom Divider -->
					<Border BorderBrush="{StaticResource Steel700Brush}" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
						<TextBlock Text="DEBUG" Foreground="{StaticResource Steel300Brush}"
						           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10"
						           VerticalAlignment="Center" />
					</Border>

					<!-- Top Row: Debugging Toggle -->
					<Grid Margin="0,0,0,12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="VERBOSE LOGGING" Foreground="White"
							           FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11.5" />
						</StackPanel>

						<CheckBox Grid.Column="1" x:Name="TogDebugging" Style="{StaticResource ModernToggleStyle}"
						          HorizontalAlignment="Right" VerticalAlignment="Center"
						          IsChecked="{Binding IsDebuggingEnabled, UpdateSourceTrigger=PropertyChanged}"
						          ToolTip="Log EC registers, WMI calls, and GPU transitions to the Nitrous log. Off = minimal disk writes." />
					</Grid>

					<!-- 3-Action Buttons Grid (Primary: REPORT, Secondary: COPY & LOGS) -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- REPORT (Primary High-Contrast Ember) -->
						<controls:ChamferButton Grid.Column="0" x:Name="BtnReportIssue"
						                        Variant="Primary"
						                        Content="REPORT"
						                        Command="{Binding ReportIssueCommand}"
						                        Height="32" Padding="4,0"
						                        ToolTip="Open the GitHub issue form with diagnostics pre-filled and copied to the clipboard." />

						<!-- COPY (Secondary High-Contrast Steel) -->
						<controls:ChamferButton Grid.Column="2" x:Name="BtnCopyDiagnostics"
						                        Variant="Secondary"
						                        Content="COPY"
						                        Command="{Binding CopyDiagnosticsCommand}"
						                        Height="32" Padding="4,0"
						                        ToolTip="Copy an anonymized hardware diagnostics summary to the clipboard." />

						<!-- LOGS (Secondary High-Contrast Steel) -->
						<controls:ChamferButton Grid.Column="4" x:Name="BtnOpenLogsFolder"
						                        Variant="Secondary"
						                        Content="LOGS"
						                        Command="{Binding OpenLogsFolderCommand}"
						                        Height="32" Padding="4,0"
						                        ToolTip="Open the log folder in File Explorer." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>
		</StackPanel>
	</ScrollViewer>
</UserControl>

