<UserControl x:Class="Nitrous.Ui.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nitrous.Ui.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Styles/DashboardStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<ScrollViewer Margin="20,10,20,0" VerticalScrollBarVisibility="Hidden"
	              HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0,0,4,20">
		<StackPanel>
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" Margin="0,0,0,12" Padding="12">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Border Width="44" Height="44" CornerRadius="0" Background="{StaticResource Steel850Brush}" Margin="0,0,12,0">
						<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="8"
						       Stretch="Uniform" />
					</Border>
					<StackPanel VerticalAlignment="Center">
						<TextBlock x:Name="SettingsVersionText" Text="NITROUS" Foreground="White" FontWeight="Bold" FontSize="13" />
						<TextBlock Text="HARDWARE CONTROL FOR ACER NITRO LAPTOPS." Foreground="{StaticResource Steel400Brush}" FontSize="10.5"
						           Margin="0,2,0,0" />
					</StackPanel>
				</StackPanel>
			</controls:ChamferCard>
			<TextBlock Text="POWER &amp; PERFORMANCE RULES" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"
			           Margin="0,0,0,8" />
			<!-- Manage CPU Power Toggle -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Height="70" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      Margin="0,0,0,10"
			                      ToolTip="Synchronizes Windows processor limits per profile: Quiet (85% max, Boost Off), Balanced (99% max, Boost Off), Performance (100% max, Boost On), and Turbo (100% min/max, Boost On). Eliminates thermal throttling and fan revving.">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
							<Path
								Data="M7,4V6H5C3.89,6 3,6.89 3,8V10H1V12H3V14H1V16H3V18C3,19.1 3.89,20 5,20H7V22H9V20H11V22H13V20H15V22H17V20H19C20.1,20 21,19.1 21,18V16H23V14H21V12H23V10H21V8C21,6.89 20.1,6 19,6H17V4H15V6H13V4H11V6H9V4H7M5,8H19V18H5V8M7,10V16H17V10H7M9,12H15V14H9V12Z"
								Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
							<TextBlock Text="MANAGE CPU POWER LIMITS" Foreground="White" FontWeight="Bold" FontSize="11.5"
							           VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="AUTOMATICALLY ADJUST WINDOWS CPU POWER LIMITS BASED ON THE ACTIVE PROFILE."
						           Foreground="{StaticResource Steel400Brush}" FontSize="10.5" TextWrapping="Wrap" />
					</StackPanel>
					<CheckBox Grid.Column="1" x:Name="TogManageCpu" Style="{StaticResource ModernToggleStyle}"
					          HorizontalAlignment="Right" Margin="0,0,15,0"
					          IsChecked="{Binding ManageCpuPower, UpdateSourceTrigger=PropertyChanged}"
					          ToolTip="Synchronizes Windows processor limits per profile: Quiet (85% max, Boost Off), Balanced (99% max, Boost Off), Performance (100% max, Boost On), and Turbo (100% min/max, Boost On). Eliminates thermal throttling and fan revving." />
				</Grid>
			</controls:ChamferCard>
			<!-- Battery Health Diagnostics & Limit -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Margin="0,0,0,10" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      Padding="15"
			                      ToolTip="Displays native battery health, maximum charge capacity, total charge cycles, and charge limit controls.">
				<StackPanel>
					<!-- Header -->
					<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
						<Path
							Data="M16.67,4H15V2H9V4H7.33A1.33,1.33 0 0,0 6,5.33V20.67C6,21.4 6.6,22 7.33,22H16.67A1.33,1.33 0 0,0 18,20.67V5.33C18,4.6 17.4,4 16.67,4Z"
							Fill="White" Stretch="Uniform" Width="10" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
						<TextBlock Text="BATTERY MANAGEMENT" Foreground="White" FontWeight="Bold" FontSize="11.5"
						           VerticalAlignment="Center" />
					</StackPanel>
					<!-- Health -->
					<Grid Margin="0,0,0,8">
						<TextBlock Text="BATTERY HEALTH" Foreground="{StaticResource Steel400Brush}" FontSize="10.5" VerticalAlignment="Center" />
						<TextBlock Text="{Binding BatteryHealthPercentText}" Foreground="White" FontSize="11" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<!-- Capacity -->
					<Grid Margin="0,0,0,8">
						<TextBlock Text="CHARGE CAPACITY" Foreground="{StaticResource Steel400Brush}" FontSize="10.5" VerticalAlignment="Center" />
						<TextBlock Text="{Binding BatteryHealthText}" Foreground="White" FontSize="11" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
					<!-- Cycles -->
					<Grid Margin="0,0,0,15">
						<TextBlock Text="CHARGE CYCLES" Foreground="{StaticResource Steel400Brush}" FontSize="10.5" VerticalAlignment="Center" />
						<TextBlock Text="{Binding BatteryCycleText}" Foreground="White" FontSize="11" FontWeight="Bold"
						           HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>

					<!-- Divider -->
					<Border Height="1" Background="{StaticResource Steel700Brush}" Margin="-15,0,-15,12" />

					<!-- 80% Limit Toggle -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="80% BATTERY LIMIT" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,2" />
							<TextBlock Text="EXTENDS LIFESPAN BY CAPPING MAX CHARGE." Foreground="{StaticResource Steel400Brush}" FontSize="10"
							           TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox Grid.Column="1" x:Name="TogCharge" Style="{StaticResource ModernToggleStyle}"
						          HorizontalAlignment="Right"
						          IsChecked="{Binding ChargeLimit, UpdateSourceTrigger=PropertyChanged}"
						          ToolTip="Signals the Acer EC to cap battery charging at 80%, reducing chemical stress and extending battery longevity." />
					</Grid>

					<!-- Divider -->
					<Border Height="1" Background="{StaticResource Steel700Brush}" Margin="-15,0,-15,12" />

					<!-- Acer Background Services -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ToggleButton x:Name="BtnAcerServicesDetails" Grid.Column="0" HorizontalAlignment="Left"
						              Background="Transparent" BorderThickness="0">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="Transparent" Cursor="Hand">
										<ContentPresenter />
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="ACER BACKGROUND SERVICES" Foreground="White" FontWeight="Bold" FontSize="11"
								           Margin="0,0,0,2" />
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding AcerServicesStatusText}" Foreground="{StaticResource Steel400Brush}" FontSize="10" TextWrapping="Wrap" />
								</StackPanel>
							</StackPanel>
						</ToggleButton>

						<Popup IsOpen="{Binding IsChecked, ElementName=BtnAcerServicesDetails, Mode=TwoWay}" StaysOpen="False"
						       PlacementTarget="{Binding ElementName=BtnAcerServicesDetails}" Placement="Bottom">
							<Border Background="{StaticResource Steel950Brush}" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1" CornerRadius="0" Padding="10"
							        Margin="0,4,0,0">
								<ItemsControl ItemsSource="{Binding AcerServicesList}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,2" ToolTip="{Binding DisplayName}">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<Button Grid.Column="0" Style="{StaticResource GhostBtn}" Padding="2" Margin="0,0,6,0"
												        Command="{Binding DataContext.KillAcerServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
												        CommandParameter="{Binding ServiceName}"
												        ToolTip="Stop and disable this specific service.">
													<Path
														Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z"
														Fill="#FF4500" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" />
												</Button>
												<TextBlock Grid.Column="1" Text="{Binding ServiceName}" Foreground="#A1A1AA" FontSize="10"
												           VerticalAlignment="Center" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</Popup>
						<Button x:Name="BtnAcerServices" Grid.Column="1" Style="{StaticResource AccentBtn}"
						        HorizontalAlignment="Right" Background="#FF4500"
						        Padding="12,6"
						        Command="{Binding ToggleAcerServicesCommand}"
						        ToolTip="Stops NitroSense and Acer Care Center services to free system RAM, reduce background CPU, and prevent OEM software from overriding Nitrous fan curves.">
							<TextBlock Text="{Binding AcerServicesActionText}" FontSize="10" FontWeight="Bold" />
						</Button>
					</Grid>

					<!-- Divider -->
					<Border Height="1" Background="{StaticResource Steel700Brush}" Margin="-15,0,-15,12" />

					<!-- Auto-Switch Power Toggle -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="AUTO-SWITCH POWER" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,2" />
							<TextBlock Text="ADAPTS PERFORMANCE PLAN BASED ON AC/DC STATE." Foreground="{StaticResource Steel400Brush}" FontSize="10"
							           TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox Grid.Column="1" x:Name="TogAutoSwitch" Style="{StaticResource ModernToggleStyle}"
						          HorizontalAlignment="Right"
						          IsChecked="{Binding AutoSwitch, UpdateSourceTrigger=PropertyChanged}"
						          ToolTip="Automatically activates your preferred AC profile when plugged in and DC profile when running on battery." />
					</Grid>
				</StackPanel>
			</controls:ChamferCard>
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Height="70" Margin="0,0,0,10" BorderBrush="{StaticResource Steel700Brush}"
			                      BorderThickness="1"
			                      ToolTip="Automatically applies your saved GPU clock offsets whenever the discrete NVIDIA GPU wakes up from D3Cold sleep on AC power.">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
							<Path
								Data="M11,15H6L13,1V9H18L11,23V15Z"
								Fill="White" Stretch="Uniform" Width="10" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
							<TextBlock Text="AUTO-APPLY GPU CLOCKS" Foreground="White" FontWeight="Bold" FontSize="11.5"
							           VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="APPLY SAVED OFFSETS WHEN DGPU WAKES ON AC." Foreground="{StaticResource Steel400Brush}" FontSize="10.5" TextWrapping="Wrap" />
					</StackPanel>
					<CheckBox Grid.Column="1" x:Name="TogAutoApplyClocks" Style="{StaticResource ModernToggleStyle}"
					          HorizontalAlignment="Right" Margin="0,0,15,0"
					          IsChecked="{Binding AutoApplyGpuClocks, UpdateSourceTrigger=PropertyChanged}"
					          ToolTip="Automatically applies your saved GPU clock offsets whenever the discrete NVIDIA GPU wakes up from D3Cold sleep on AC power." />
				</Grid>
			</controls:ChamferCard>
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Height="70" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      Margin="0,0,0,10"
			                      ToolTip="Registers an elevated Task Scheduler task to start Nitrous silently in the system tray at Windows logon without UAC prompts.">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
							<Path
								Data="M14,2L12.6,3.4C11.6,4.4 10.9,5.7 10.6,7.1L9.6,12L4.5,13.7C3.5,14 2.8,14.8 2.5,15.8L2.2,16.8L6.8,15.2C7.3,15 7.8,15 8.3,15.1L12.5,16.4C12.4,16.7 12.3,17 12.1,17.2L10.7,18.6L12.1,20L15.6,16.5C16.8,15.3 17.5,13.8 17.8,12.1L18.7,6.8L22,5.7C23,5.4 23.7,4.6 24,3.6L24.3,2.6L19.7,4.2C19.2,4.4 18.7,4.4 18.2,4.3L14,3C14.1,2.7 14.2,2.4 14.4,2.2L15.8,0.8L14,2Z"
								Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
							<TextBlock Text="RUN ON STARTUP" Foreground="White" FontWeight="Bold" FontSize="11.5"
							           VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="LAUNCH NITROUS ENGINE SILENTLY AT BOOT." Foreground="{StaticResource Steel400Brush}" FontSize="10.5"
						           TextWrapping="Wrap" />
					</StackPanel>
					<CheckBox Grid.Column="1" x:Name="TogStartup" Style="{StaticResource ModernToggleStyle}"
					          HorizontalAlignment="Right" Margin="0,0,15,0"
					          IsChecked="{Binding RunOnStartup, UpdateSourceTrigger=PropertyChanged}"
					          ToolTip="Registers an elevated Task Scheduler task to start Nitrous silently in the system tray at Windows logon without UAC prompts." />
				</Grid>
			</controls:ChamferCard>
			<TextBlock Text="DIAGNOSTICS" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"
			           Margin="0,8,0,8" />
			<!-- Debugging Toggle -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Height="70" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      Margin="0,0,0,10"
			                      ToolTip="Enables verbose diagnostic logging of Acer EC registers, WMI calls, and GPU sleep transitions to %LOCALAPPDATA%\Nitrous\Logs\nitrous.log. Turn off during normal use for minimal disk writes.">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
							<!-- Bug / Diagnostics Icon Path -->
							<Path
								Data="M20,8H17.19C16.74,7.22 16.12,6.55 15.37,6.04L17,4.41L15.59,3L13.42,5.17C12.96,5.06 12.49,5 12,5C11.51,5 11.04,5.06 10.59,5.17L8.41,3L7,4.41L8.62,6.04C7.88,6.55 7.26,7.22 6.81,8H4V10H6.09C6.04,10.33 6,10.66 6,11V12H4V14H6V15C6,15.34 6.04,15.67 6.09,16H4V18H6.81C7.85,19.79 9.78,21 12,21C14.22,21 16.15,19.79 17.19,18H20V16H17.91C17.96,15.67 18,15.34 18,15V14H20V12H18V11C18,10.66 17.96,10.33 17.91,10H20V8M16,15A4,4 0 0,1 12,19A4,4 0 0,1 8,15V11A4,4 0 0,1 12,7A4,4 0 0,1 16,7V15Z"
								Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
							<TextBlock Text="DEBUGGING" Foreground="White" FontWeight="Bold" FontSize="11.5"
							           VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="RECORD DETAILED HARDWARE SENSOR REGISTERS AND WMI OPERATIONS TO DISK."
						           Foreground="{StaticResource Steel400Brush}" FontSize="10.5" TextWrapping="Wrap" />
					</StackPanel>
					<CheckBox Grid.Column="1" x:Name="TogDebugging" Style="{StaticResource ModernToggleStyle}"
					          HorizontalAlignment="Right" Margin="0,0,15,0"
					          IsChecked="{Binding IsDebuggingEnabled, UpdateSourceTrigger=PropertyChanged}"
					          ToolTip="Enables verbose diagnostic logging of Acer EC registers, WMI calls, and GPU sleep transitions to %LOCALAPPDATA%\Nitrous\Logs\nitrous.log. Turn off during normal use for minimal disk writes." />
				</Grid>
			</controls:ChamferCard>
			<!-- Diagnostics Actions Card -->
			<controls:ChamferCard ChamferSize="6" Background="{StaticResource Steel900Brush}" Margin="0,0,0,10" BorderBrush="{StaticResource Steel700Brush}" BorderThickness="1"
			                      Padding="15"
			                      ToolTip="Diagnostic troubleshooting utilities: open the local log folder or copy a complete hardware diagnostic report to clipboard.">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
							<Path
								Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
								Fill="White" Stretch="Uniform" Width="12" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
							<TextBlock Text="SYSTEM DIAGNOSTICS &amp; LOGS" Foreground="White" FontWeight="Bold" FontSize="11.5"
							           VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="OPEN LOG FILES, COPY DIAGNOSTICS, OR REPORT A BUG ON GITHUB."
						           Foreground="{StaticResource Steel400Brush}" FontSize="10.5" TextWrapping="Wrap" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
						<Button x:Name="BtnReportIssue" Style="{StaticResource AccentBtn}" Background="#FF4500"
						        Width="{Binding ActualWidth, ElementName=BtnAcerServices}" MinWidth="80"
						        Padding="12,5" Margin="0,0,0,5"
						        HorizontalContentAlignment="Center"
						        Command="{Binding ReportIssueCommand}"
						        ToolTip="Opens the GitHub bug report form in your browser with hardware specs pre-filled, and copies complete diagnostics to clipboard.">
							<TextBlock Text="REPORT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
						</Button>
						<Button x:Name="BtnCopyDiagnostics" Style="{StaticResource GhostBtn}"
						        Width="{Binding ActualWidth, ElementName=BtnAcerServices}" MinWidth="80"
						        Padding="12,5" Margin="0,0,0,5"
						        HorizontalContentAlignment="Center"
						        Command="{Binding CopyDiagnosticsCommand}"
						        ToolTip="Generates an anonymized hardware diagnostics summary and copies it to your clipboard for GitHub issue reports.">
							<TextBlock Text="COPY" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
						</Button>
						<Button x:Name="BtnOpenLogsFolder" Style="{StaticResource GhostBtn}"
						        Width="{Binding ActualWidth, ElementName=BtnAcerServices}" MinWidth="80"
						        Padding="12,5"
						        HorizontalContentAlignment="Center"
						        Command="{Binding OpenLogsFolderCommand}"
						        ToolTip="Opens the directory containing Nitrous diagnostic log files in File Explorer.">
							<TextBlock Text="LOGS" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
						</Button>
					</StackPanel>
				</Grid>
			</controls:ChamferCard>
		</StackPanel>
	</ScrollViewer>
</UserControl>
