<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Nitrous.Helpers">

	<!-- ===================================================================== -->
	<!-- 1. NITROUS IGNITE PALETTE TOKENS (Steel & Ember)                      -->
	<!-- Reference: nitrous - ignite.html                                      -->
	<!-- ===================================================================== -->

	<!-- Steel Neutrals (Dark metals / Industrial forge) -->
	<Color x:Key="Steel950Color">#08080A</Color>
	<SolidColorBrush x:Key="Steel950Brush" Color="{StaticResource Steel950Color}" />

	<Color x:Key="Steel900Color">#0B0B0D</Color>
	<SolidColorBrush x:Key="Steel900Brush" Color="{StaticResource Steel900Color}" />

	<Color x:Key="Steel850Color">#121215</Color>
	<SolidColorBrush x:Key="Steel850Brush" Color="{StaticResource Steel850Color}" />

	<Color x:Key="Steel800Color">#18181C</Color>
	<SolidColorBrush x:Key="Steel800Brush" Color="{StaticResource Steel800Color}" />

	<Color x:Key="Steel700Color">#26262B</Color>
	<SolidColorBrush x:Key="Steel700Brush" Color="{StaticResource Steel700Color}" />

	<Color x:Key="Steel600Color">#36363E</Color>
	<SolidColorBrush x:Key="Steel600Brush" Color="{StaticResource Steel600Color}" />

	<Color x:Key="Steel500Color">#52525C</Color>
	<SolidColorBrush x:Key="Steel500Brush" Color="{StaticResource Steel500Color}" />

	<Color x:Key="Steel400Color">#8A8A96</Color>
	<SolidColorBrush x:Key="Steel400Brush" Color="{StaticResource Steel400Color}" />

	<Color x:Key="Steel300Color">#B8B8C2</Color>
	<SolidColorBrush x:Key="Steel300Brush" Color="{StaticResource Steel300Color}" />

	<Color x:Key="Steel200Color">#D4D4D9</Color>
	<SolidColorBrush x:Key="Steel200Brush" Color="{StaticResource Steel200Color}" />

	<Color x:Key="Steel100Color">#EDEDEF</Color>
	<SolidColorBrush x:Key="Steel100Brush" Color="{StaticResource Steel100Color}" />

	<!-- Ember Accents (Thermal / Forge heat) -->
	<Color x:Key="Ember900Color">#361309</Color>
	<SolidColorBrush x:Key="Ember900Brush" Color="{StaticResource Ember900Color}" />

	<Color x:Key="Ember700Color">#9A3412</Color>
	<SolidColorBrush x:Key="Ember700Brush" Color="{StaticResource Ember700Color}" />

	<Color x:Key="Ember600Color">#C24116</Color>
	<SolidColorBrush x:Key="Ember600Brush" Color="{StaticResource Ember600Color}" />

	<Color x:Key="Ember500Color">#D94E1F</Color>
	<SolidColorBrush x:Key="Ember500Brush" Color="{StaticResource Ember500Color}" />

	<Color x:Key="Ember400Color">#E85D2A</Color>
	<SolidColorBrush x:Key="Ember400Brush" Color="{StaticResource Ember400Color}" />

	<!-- Alert Severity (muted forge tones on steel; no neon OS palette) -->
	<Color x:Key="AlertSuccessColor">#4CAF7D</Color>
	<SolidColorBrush x:Key="AlertSuccessBrush" Color="{StaticResource AlertSuccessColor}" />

	<Color x:Key="AlertDangerColor">#E5484D</Color>
	<SolidColorBrush x:Key="AlertDangerBrush" Color="{StaticResource AlertDangerColor}" />

	<!-- Functional Aliases -->
	<SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource Ember500Color}" />
	<SolidColorBrush x:Key="BrandAccentGlowBrush" Color="{StaticResource Ember400Color}" />
	<SolidColorBrush x:Key="SurfaceDeepBrush" Color="{StaticResource Steel950Color}" />
	<SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource Steel900Color}" />
	<SolidColorBrush x:Key="SurfaceButtonBrush" Color="{StaticResource Steel850Color}" />
	<Color x:Key="BorderCardColor">#383842</Color>
	<SolidColorBrush x:Key="BorderCardBrush" Color="{StaticResource BorderCardColor}" />
	<SolidColorBrush x:Key="BorderShellBrush" Color="{StaticResource Steel600Color}" />
	<SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Steel100Color}" />
	<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Steel400Color}" />

	<!-- Typography -->
	<FontFamily x:Key="SansFontFamily">Inter, Segoe UI Variable Text, Segoe UI, Arial, sans-serif</FontFamily>
	<FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Cascadia Code, Consolas, Courier New, monospace</FontFamily>

	<!-- Cached Application Logo -->
	<BitmapImage x:Key="CachedAppLogo" UriSource="pack://application:,,,/Nitrous;component/assets/logo.png"
	             CacheOption="OnLoad" />

	<!-- Boolean to Visibility Converter -->
	<BooleanToVisibilityConverter x:Key="BoolToVis" />

	<!-- Uppercase Value Converter -->
	<helpers:UpperCaseConverter x:Key="UpperConverter" />

	<!-- ===================================================================== -->
	<!-- 2. IGNITE ACTION BUTTON / DETENT STYLE (Zero Radius)                  -->
	<!-- ===================================================================== -->
	<Style x:Key="ActionButtonStyle" TargetType="RadioButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource Steel400Brush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="TabIndex" Value="1" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Grid Background="Transparent">
						<!-- Main Detent Surface -->
						<Border x:Name="MainBorder"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="0"
						        Margin="0"
						        SnapsToDevicePixels="True">
							<Grid>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Path x:Name="IconPath"
									      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
									      Fill="{TemplateBinding Foreground}"
									      Stretch="Uniform"
									      Width="12" Height="12"
									      Margin="0,0,5,0"
									      VerticalAlignment="Center"
									      Visibility="Collapsed" />
									<TextBlock x:Name="ContentText"
									           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperConverter}}"
									           Foreground="{TemplateBinding Foreground}"
									           FontFamily="{StaticResource MonoFontFamily}"
									           FontSize="11"
									           FontWeight="Bold"
									           VerticalAlignment="Center" />
								</StackPanel>
								<!-- Ignite Detent Accent Line (Constant fixed length 32px matching w-8 at original elevated bottom position) -->
								<Border x:Name="IndicatorLine"
								        Height="2"
								        Width="36"
								        Background="{StaticResource Steel600Brush}"
								        HorizontalAlignment="Center"
								        VerticalAlignment="Bottom"
								        Margin="0,0,0,5" />
							</Grid>
						</Border>
						<!-- Segment divider renders above the surface so the active fill never covers it -->
						<Border x:Name="LeftDivider"
						        Width="1"
						        Height="24"
						        Background="{StaticResource Steel700Brush}"
						        HorizontalAlignment="Left"
						        VerticalAlignment="Center" />
					</Grid>
					<ControlTemplate.Triggers>
						<!-- Show icon if Tag is present -->
						<Trigger Property="Tag" Value="{x:Null}">
							<Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<!-- Hide divider for first item in rail -->
						<Trigger Property="TabIndex" Value="0">
							<Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<!-- Hover State -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel850Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="IndicatorLine" Property="Background" Value="{StaticResource Steel500Brush}" />
							<Setter TargetName="LeftDivider" Property="Opacity" Value="0" />
							<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0" />
							<Setter Property="Panel.ZIndex" Value="1" />
						</Trigger>
						<!-- Checked State (Active Detent): keep neighboring dividers visible -->
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel950Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="IndicatorLine" Property="Background" Value="{StaticResource Ember500Brush}" />
						</Trigger>
						<!-- Disabled State -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 2B. COMPACT ACTION BUTTON STYLE (For Tight Detent Rails)              -->
	<!-- Reference: nitrous - ignite.html fan-ctl                              -->
	<!-- ===================================================================== -->
	<Style x:Key="CompactActionButtonStyle" TargetType="RadioButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource Steel400Brush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="TabIndex" Value="1" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Grid Background="Transparent">
						<!-- Main Detent Surface -->
						<Border x:Name="MainBorder" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="0" Margin="0" SnapsToDevicePixels="True">
							<Grid>
								<TextBlock x:Name="ContentText"
								           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperConverter}}"
								           Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
								           Margin="0,0,0,3" />
								<!-- Ignite Detent Accent Line (Fixed length 24px matching w-6) -->
								<Border x:Name="IndicatorLine" Height="2" Width="28" Background="{StaticResource Steel600Brush}"
								        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
							</Grid>
						</Border>
						<!-- Segment divider renders above the surface so the active fill never covers it -->
						<Border x:Name="LeftDivider" Width="1" Height="18" Background="{StaticResource Steel700Brush}"
						        HorizontalAlignment="Left" VerticalAlignment="Center" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="TabIndex" Value="0">
							<Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel850Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="IndicatorLine" Property="Background" Value="{StaticResource Steel500Brush}" />
							<Setter TargetName="LeftDivider" Property="Opacity" Value="0" />
							<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0" />
							<Setter Property="Panel.ZIndex" Value="1" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel950Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="IndicatorLine" Property="Background" Value="{StaticResource Ember500Brush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 2C. VERTICAL DETENT BUTTON STYLE (Zero Radius Stacked Steps)          -->
	<!-- Reference: nitrous - ignite.html hz-step                              -->
	<!-- ===================================================================== -->
	<Style x:Key="VerticalDetentButtonStyle" TargetType="RadioButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource Steel400Brush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="TabIndex" Value="1" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Grid Background="Transparent">
						<Border x:Name="TopDivider" Height="1" Background="{StaticResource Steel700Brush}"
						        VerticalAlignment="Top" SnapsToDevicePixels="True" />
						<Border x:Name="MainBorder" Background="{TemplateBinding Background}"
						        CornerRadius="0" SnapsToDevicePixels="True">
							<Grid Margin="10,0,8,0">
								<Border x:Name="VerticalIndicator" Width="3" Background="{StaticResource Steel700Brush}"
								        HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-10,0,0,0" SnapsToDevicePixels="True" />
								<TextBlock x:Name="TitleText"
								           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperConverter}}"
								           Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
								<TextBlock x:Name="SubText"
								           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperConverter}}"
								           Foreground="{StaticResource Steel500Brush}" FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="8.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
							</Grid>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="TabIndex" Value="0">
							<Setter TargetName="TopDivider" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel850Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="VerticalIndicator" Property="Background" Value="{StaticResource Steel500Brush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Steel950Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
							<Setter TargetName="VerticalIndicator" Property="Background" Value="{StaticResource Ember500Brush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 2D. IGNITE INDUSTRIAL PROGRESS BAR (Zero Radius Read Bar)             -->
	<!-- Reference: nitrous - ignite.html fanCpuBarRead                        -->
	<!-- ===================================================================== -->
	<Style x:Key="IgniteProgressBarStyle" TargetType="ProgressBar">
		<Setter Property="Height" Value="8" />
		<Setter Property="Background" Value="{StaticResource Steel900Brush}" />
		<Setter Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ProgressBar">
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" SnapsToDevicePixels="True">
						<Grid x:Name="PART_Track">
							<Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left"
							           SnapsToDevicePixels="True" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 2E. SMALL GHOST TOGGLE BUTTON (Zero Radius)                           -->
	<!-- ===================================================================== -->
	<Style x:Key="SmallGhostToggleBtn" TargetType="ToggleButton">
		<Setter Property="Background" Value="{StaticResource Steel900Brush}" />
		<Setter Property="Foreground" Value="{StaticResource Steel400Brush}" />
		<Setter Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FontSize" Value="8" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Padding" Value="4,1" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource Steel800Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource Steel850Brush}" />
							<Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Ember400Brush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
		<!-- ===================================================================== -->
	<!-- 3. MECHANICAL ANVIL DIP SWITCH (Chamfered Industrial Rocker)          -->
	<!-- Reference: toggleDipSwitch in ignite.html                             -->
	<!-- ===================================================================== -->
	<Style x:Key="ModernToggleStyle" TargetType="CheckBox">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FontSize" Value="8.5" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid Width="52" Height="22" SnapsToDevicePixels="True"
					      Clip="M 0,0 L 48,0 52,4 52,22 4,22 0,18 Z">
						<!-- Chamfered Shell: 52x22, 4px cut at Top-Right and Bottom-Left, 0.5px stroke inset -->
						<Path x:Name="OuterFrame"
						      Data="M 0.5,0.5 L 47.5,0.5 51.5,4.5 51.5,21.5 4.5,21.5 0.5,17.5 Z"
						      Fill="{StaticResource Steel950Brush}"
						      Stroke="{StaticResource Steel700Brush}"
						      StrokeThickness="1"
						      SnapsToDevicePixels="True" />

						<!-- Two-state rocker content clipped to inner chamfer to perfectly match the border -->
						<Grid Margin="1" Clip="M 0,0 L 46,0 50,4 50,20 4,20 0,16 Z">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!-- OFF Pill (Left) -->
							<Border x:Name="OffPill" Grid.Column="0"
							        Background="{StaticResource Steel700Brush}"
							        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
							        SnapsToDevicePixels="True">
								<TextBlock x:Name="OffText" Text="OFF"
								           Foreground="{StaticResource Steel200Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="8.5" FontWeight="Bold"
								           HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>

							<!-- ON Pill (Right) -->
							<Border x:Name="OnPill" Grid.Column="1"
							        Background="Transparent"
							        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
							        SnapsToDevicePixels="True">
								<TextBlock x:Name="OnText" Text="ON"
								           Foreground="{StaticResource Steel500Brush}"
								           FontFamily="{StaticResource MonoFontFamily}"
								           FontSize="8.5" FontWeight="Bold"
								           HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
						</Grid>
					</Grid>

					<ControlTemplate.Triggers>
						<!-- Checked (ON) State -->
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="OuterFrame" Property="Stroke" Value="{StaticResource Steel600Brush}" />
							<Setter TargetName="OffPill" Property="Background" Value="Transparent" />
							<Setter TargetName="OffText" Property="Foreground" Value="{StaticResource Steel500Brush}" />
							<Setter TargetName="OnPill" Property="Background" Value="{StaticResource Ember500Brush}" />
							<Setter TargetName="OnText" Property="Foreground" Value="{StaticResource Steel950Brush}" />
						</Trigger>

						<!-- MouseOver State -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="OuterFrame" Property="Stroke" Value="{StaticResource Steel500Brush}" />
						</Trigger>

						<!-- Disabled State -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 3B. MINI DIP TOGGLE STYLE (Chamfered Compact Badge)                   -->
	<!-- Reference: toggleMiniDip in ignite.html                               -->
	<!-- ===================================================================== -->
	<Style x:Key="ChamferMiniToggleStyle" TargetType="CheckBox">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FontSize" Value="8.5" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid Width="36" Height="20" SnapsToDevicePixels="True">
						<!-- Chamfered Shell: 36x20, 3px cut at Top-Right and Bottom-Left, 0.5px stroke inset -->
						<Path x:Name="MiniFrame"
						      Data="M 0.5,0.5 L 32.5,0.5 35.5,3.5 35.5,19.5 3.5,19.5 0.5,16.5 Z"
						      Fill="{StaticResource Steel850Brush}"
						      Stroke="{StaticResource Steel700Brush}"
						      StrokeThickness="1"
						      SnapsToDevicePixels="True" />

						<TextBlock x:Name="MiniText" Text="OFF"
						           Foreground="{StaticResource Steel400Brush}"
						           FontFamily="{StaticResource MonoFontFamily}"
						           FontSize="8.5" FontWeight="Bold"
						           HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>

					<ControlTemplate.Triggers>
						<!-- Checked (ON) State -->
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="MiniFrame" Property="Fill" Value="{StaticResource Ember500Brush}" />
							<Setter TargetName="MiniFrame" Property="Stroke" Value="{StaticResource Ember600Brush}" />
							<Setter TargetName="MiniText" Property="Text" Value="ON" />
							<Setter TargetName="MiniText" Property="Foreground" Value="{StaticResource Steel950Brush}" />
						</Trigger>

						<!-- MouseOver State -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True" />
								<Condition Property="IsChecked" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="MiniFrame" Property="Stroke" Value="{StaticResource Steel500Brush}" />
							<Setter TargetName="MiniFrame" Property="Fill" Value="{StaticResource Steel800Brush}" />
							<Setter TargetName="MiniText" Property="Foreground" Value="{StaticResource Steel200Brush}" />
						</MultiTrigger>

						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True" />
								<Condition Property="IsChecked" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="MiniFrame" Property="Fill" Value="{StaticResource Ember400Brush}" />
							<Setter TargetName="MiniFrame" Property="Stroke" Value="{StaticResource Ember500Brush}" />
						</MultiTrigger>

						<!-- Disabled State -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 4. ANVIL SLIDER STYLE (Zero Radius)                                   -->
	<!-- Reference: input[type=range].anvil-slider in ignite.html              -->
	<!-- ===================================================================== -->
	<Style x:Key="ModernSliderStyle" TargetType="Slider">
		<Setter Property="SmallChange" Value="1" />
		<Setter Property="LargeChange" Value="10" />
		<Setter Property="IsMoveToPointEnabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid Height="20" SnapsToDevicePixels="True">
						<!-- Track Background -->
						<Border Height="4"
						        Background="{StaticResource Steel950Brush}"
						        BorderBrush="{StaticResource Steel600Brush}"
						        BorderThickness="1"
						        CornerRadius="0"
						        VerticalAlignment="Center" />
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Height="4"
											        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
											        CornerRadius="0" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb>
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<!-- Anvil Rectangular Thumb -->
											<Border x:Name="ThumbBorder"
											        Width="6" Height="14"
											        Background="{StaticResource Ember400Brush}"
											        CornerRadius="0"
											        Cursor="Hand"
											        SnapsToDevicePixels="True" />
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Steel100Brush}" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="Transparent" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 5. SQUARE CHECKBOX STYLE (Zero Radius)                                -->
	<!-- ===================================================================== -->
	<Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<StackPanel Orientation="Horizontal">
						<Border Width="12" Height="12"
						        Background="{StaticResource Steel850Brush}"
						        BorderBrush="{StaticResource Steel600Brush}"
						        BorderThickness="1"
						        CornerRadius="0"
						        VerticalAlignment="Center"
						        Margin="0,0,6,0">
							<Path x:Name="CheckIcon"
							      Data="M3,8L6,11L11,3"
							      Stroke="{StaticResource Ember500Brush}"
							      StrokeThickness="2"
							      Stretch="Uniform"
							      Margin="1.5"
							      Visibility="Collapsed" />
						</Border>
						<TextBlock
							Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperConverter}}"
							Foreground="{TemplateBinding Foreground}"
							FontFamily="{StaticResource MonoFontFamily}"
							FontSize="11.5"
							FontWeight="Bold"
							VerticalAlignment="Center" />
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 6. NAV BUTTON STYLE (Zero Radius)                                     -->
	<!-- ===================================================================== -->
	<Style x:Key="NavButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" CornerRadius="0" SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource Steel850Brush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 7. GHOST BUTTON STYLE (Zero Radius)                                   -->
	<!-- ===================================================================== -->
	<Style x:Key="GhostBtn" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource Steel850Brush}" />
		<Setter Property="Foreground" Value="{StaticResource Steel300Brush}" />
		<Setter Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="BtnBorder"
					        Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="0"
					        SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource Steel800Brush}" />
							<Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
							<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 8. ACCENT BUTTON STYLE (Zero Radius)                                  -->
	<!-- ===================================================================== -->
	<Style x:Key="AccentBtn" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource Ember500Brush}" />
		<Setter Property="Foreground" Value="{StaticResource Steel950Brush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" CornerRadius="0" SnapsToDevicePixels="True">
						<Grid>
							<Border x:Name="HoverOverlay" Background="{StaticResource Steel100Brush}" Opacity="0" CornerRadius="0" />
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="HoverOverlay" Property="Opacity" Value="0.2" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 9. HOTKEY TEXTBOX STYLE (Zero Radius)                                 -->
	<!-- ===================================================================== -->
	<Style x:Key="HotkeyTextBoxStyle" TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource Steel950Brush}" />
		<Setter Property="Foreground" Value="{StaticResource Steel100Brush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="BoxBorder"
					        Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="0"
					        Padding="0,4,0,0"
					        SnapsToDevicePixels="True">
						<ScrollViewer x:Name="PART_ContentHost" Margin="0" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource Steel600Brush}" />
							<Setter TargetName="BoxBorder" Property="Background" Value="{StaticResource Steel850Brush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource Ember500Brush}" />
							<Setter TargetName="BoxBorder" Property="Background" Value="{StaticResource Steel950Brush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================================================================== -->
	<!-- 10. TOOLTIP STYLE (shared chamfered shell, merged from TooltipStyles) -->
	<!-- ===================================================================== -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="TooltipStyles.xaml" />
		<ResourceDictionary Source="ComboBoxStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

